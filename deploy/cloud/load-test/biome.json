{
	"$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
	"extends": "//",
	"root": false,
	"files": {
		"includes": ["src/**/*.ts", "test/**/*.ts", "*.json", "*.md"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
