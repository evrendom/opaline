<clickhouse>
    <users>
        <default>
            <networks replace="replace">
                <ip>::1</ip>
                <ip>127.0.0.1</ip>
            </networks>
        </default>
        <opaline>
            <password from_env="OPALINE_CLICKHOUSE_PASSWORD"/>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </opaline>
    </users>
</clickhouse>
