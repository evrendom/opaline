# Opaline on a NAS or small server. install.sh writes .env from this file with
# fresh secrets; to do it by hand, copy it to .env and fill in every empty value.
# Generate each secret with:   openssl rand -hex 32
# (or, without openssl:        head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
# Use hex secrets: they go into URLs and XML unescaped.

# server = Opaline + Postgres + ClickHouse. Leave empty to run only ClickHouse
# (Opaline then runs on a laptop with --clickhouse-url). Add ,https for Caddy.
COMPOSE_PROFILES=server

# The @opalinehq/server version to build. install.sh pins the newest release;
# with a local opaline-server-<version>.tgz next to the Dockerfile it uses that.
OPALINE_VERSION=

# How browsers, the CLI and agents reach Opaline. With the https profile this is
# https://<OPALINE_DOMAIN>.
OPALINE_PUBLIC_URL=http://192.168.1.10:4100
OPALINE_BIND=0.0.0.0
OPALINE_PORT=4100

# The https profile: a domain whose DNS points at this machine, ports 80 and 443
# reachable for the certificate. Set OPALINE_BIND=127.0.0.1 so only Caddy serves.
OPALINE_DOMAIN=

POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
BETTER_AUTH_SECRET=
OPALINE_SETUP_TOKEN=

# ClickHouse memory cap (max_server_memory_usage). 3Gi holds the largest session
# insert (256 MiB) next to the background jobs; raise it on machines with RAM to spare.
CLICKHOUSE_MEMORY=3Gi
# ClickHouse HTTP on the host. 127.0.0.1 keeps it on this machine; the
# ClickHouse-only setup sets 0.0.0.0 so a laptop on the LAN can use it.
CLICKHOUSE_BIND=127.0.0.1
CLICKHOUSE_HTTP_PORT=8123
