{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"bunVersion": "1.x",
	"framework": null,
	"installCommand": "cd ../.. && bun install --frozen-lockfile",
	"buildCommand": "mkdir -p public && printf 'opaline large-ingest worker\\n' > public/index.txt",
	"outputDirectory": "public",
	"regions": ["fra1"],
	"git": {
		"deploymentEnabled": false
	},
	"functions": {
		"api/cron/large-r2-ingest.ts": {
			"includeFiles": "{../../apps/api/src/**,../../packages/*/src/**}",
			"maxDuration": 800
		},
		"api/health.ts": {
			"includeFiles": "{../../apps/api/src/**,../../packages/*/src/**}",
			"maxDuration": 30
		}
	},
	"crons": [
		{
			"path": "/api/cron/large-r2-ingest",
			"schedule": "* * * * *"
		}
	]
}
