{
	"name": "@rudel/api-routes",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./cli-data": "./src/cli-data.ts",
		"./call-paths": "./src/call-paths.ts",
		"./command-identity": "./src/command-identity.ts",
		"./command-glossary": "./src/command-glossary/index.ts",
		"./codex-usage-replay": "./src/codex-usage-replay.ts",
		"./transcript-slim": "./src/transcript-slim.ts",
		"./model-pricing": "./src/model-pricing.ts",
		"./organization-paths": "./src/organization-paths.ts",
		"./reserved-slugs": "./src/reserved-slugs.ts",
		"./rpc-batch": "./src/rpc-batch.ts",
		"./skill-icon": "./src/skill-icon.ts",
		"./transcript-records": "./src/session-transcript/transcript-records/index.ts",
		"./fact-catalog": "./src/session-transcript/transcript-records/fact-catalog.ts",
		"./session-saved-outputs": "./src/session-saved-outputs.ts",
		"./session-images": "./src/session-images.ts",
		"./session-context/*": "./src/session-context/*.ts",
		"./session-context-snapshot": "./src/session-context-snapshot.ts"
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"facts:census": "bun src/scripts/facts-census.ts",
		"facts:codex-source": "bun src/scripts/facts-codex-source.ts",
		"facts:claude-types": "bun src/scripts/facts-claude-types.ts",
		"facts:matrix": "bun src/scripts/facts-matrix.ts",
		"facts:review": "bun src/scripts/facts-review.ts",
		"test": "bun test"
	},
	"dependencies": {
		"@orpc/contract": "latest",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@rudel/secret-filter": "workspace:*",
		"@rudel/typescript-config": "workspace:*",
		"bun-types": "latest",
		"typescript": "5.9.2"
	}
}
