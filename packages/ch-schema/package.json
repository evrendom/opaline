		"ch:migrate:session-analytics-retirement": "bun scripts/migrate-session-analytics-retirement.ts",
		"ch:migrate:l1-edges": "bun scripts/migrate-l1-edges.ts",
		"ch:migrate:run-index": "bun scripts/migrate-run-index.ts",
		"ch:migrate:parser-v9": "bun scripts/migrate-parser-v9.ts",
		"ch:migrate:l1-retention": "bun scripts/migrate-l1-retention.ts",
