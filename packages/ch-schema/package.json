{
	"name": "@rudel/ch-schema",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./connection": "./src/clickhouse-connection.ts",
		"./generated": "./src/generated/index.ts",
		"./repository-evidence-index": "./src/repository-evidence-index.ts",
		"./session-analytics-mv": "./src/session-analytics-mv.ts",
		"./wrapped-archetype-centroids": "./src/wrapped-archetype-centroids.ts",
		"./wrapped-archetype-constants": "./src/wrapped-archetype-constants.ts",
		"./wrapped-archetype-rebuild": "./src/wrapped-archetype-rebuild.ts",
		"./github-outcomes": "./src/github-outcomes.ts"
	},
	"scripts": {
		"backfill:subagent-metrics": "bun scripts/backfill-subagent-metrics.ts",
		"check-types": "tsc --noEmit",
		"test": "bun test",
		"test:integration": "bun test --preload ./src/__tests__/helpers/local-clickhouse-guard.ts --max-concurrency=1 ./src/__tests__/claude-mv.integration.ts ./src/__tests__/codex-mv.integration.ts ./src/__tests__/subagent-metrics-backfill.integration.ts ./src/__tests__/session-lineage.integration.ts ./src/__tests__/repository-evidence-index.integration.ts ./src/__tests__/repository-evidence-index-migration.integration.ts ./src/__tests__/session-git-observations-migration.integration.ts ./src/__tests__/ingest-clickhouse.integration.ts ./src/__tests__/filter-version-migration.integration.ts ./src/__tests__/session-analytics-migration.integration.ts ./src/__tests__/revision-ordering-migration.integration.ts ./src/__tests__/github-outcomes-migration.integration.ts",
		"ch:generate": "bun --bun chkit generate",
		"ch:generate:dryrun": "bun --bun chkit generate --dryrun",
		"ch:migrate": "bash -c 'CLICKHOUSE_DB=default bun --bun chkit migrate --apply \"$@\"' --",
		"ch:bootstrap": "CLICKHOUSE_DB=default bun scripts/bootstrap.ts",
		"ch:migrate:f16:ci-prerequisites": "CLICKHOUSE_DB=default bun scripts/migrate-f16-ci-prerequisites.ts",
		"ch:migrate:f16": "CLICKHOUSE_DB=default bun scripts/migrate-f16.ts",
		"ch:status": "bash -c 'CLICKHOUSE_DB=default bun --bun chkit status'",
		"ch:codegen": "bun --bun chkit codegen",
		"ch:drift": "bash -c 'CLICKHOUSE_DB=default bun --bun chkit drift'",
		"ch:backfill:plan": "bash -c 'CLICKHOUSE_DB=default bun --bun chkit backfill plan \"$@\"' --",
		"ch:backfill:run": "bash -c 'CLICKHOUSE_DB=default bun --bun chkit backfill run \"$@\"' --",
		"ch:backfill:status": "bash -c 'CLICKHOUSE_DB=default bun --bun chkit backfill status \"$@\"' --",
		"chcli": "bun scripts/chcli-connect.ts",
		"ch:migrate:dependency-health": "bun scripts/migrate-dependency-health.ts",
		"ch:migrate:product-launch": "bun scripts/migrate-product-launch.ts",
		"ch:migrate:repository-evidence-index": "bun scripts/migrate-repository-evidence-index.ts",
		"ch:migrate:language-signals": "bun scripts/migrate-language-signals.ts",
		"ch:migrate:transcript-records": "bun scripts/migrate-transcript-records.ts",
		"ch:migrate:session-git-observations": "bun scripts/migrate-session-git-observations.ts",
		"ch:migrate:production": "bun scripts/production-migration-gate.ts ch:migrate:language-signals ch:migrate:transcript-records ch:migrate:repository-evidence-index ch:migrate:github-outcomes ch:migrate:session-git-observations",
		"ch:migrate:github-outcomes": "bun scripts/migrate-github-outcomes.ts"
	},
	"dependencies": {
		"@chkit/clickhouse": "0.1.0-beta.16",
		"@chkit/codegen": "0.1.0-beta.16",
		"@chkit/core": "0.1.0-beta.16",
		"@chkit/plugin-backfill": "0.1.0-beta.16",
		"@chkit/plugin-codegen": "0.1.0-beta.16",
		"@chkit/plugin-obsessiondb": "0.1.0-beta.16",
		"@chkit/plugin-pull": "0.1.0-beta.16",
		"chkit": "0.1.0-beta.16",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@obsessiondb/chcli": "0.1.1-beta.4",
		"@rudel/typescript-config": "workspace:*",
		"bun-types": "latest",
		"typescript": "5.9.2"
	}
}
