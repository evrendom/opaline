		"ch:migrate:transcript-search": "bun scripts/migrate-transcript-search.ts",
		"ch:migrate:run-index-messages": "bun scripts/migrate-run-index-messages.ts",
		"ch:migrate:run-index-capture-gaps": "bun scripts/migrate-run-index-capture-gaps.ts",
		"ch:migrate:run-index-approvals": "bun scripts/migrate-run-index-approvals.ts",
		"ch:migrate:run-activity-end": "bun scripts/migrate-run-activity-end.ts",
		"ch:migrate:run-requests": "bun scripts/migrate-run-requests.ts",
