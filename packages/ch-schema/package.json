		"ch:migrate:production": "bun scripts/production-migration-gate.ts ch:migrate:language-signals ch:migrate:transcript-records ch:migrate:transcript-record-uuid ch:migrate:repository-evidence-index ch:migrate:github-outcomes ch:migrate:session-git-observations ch:migrate:session-analytics-retirement ch:migrate:l1-edges ch:migrate:run-index ch:migrate:run-requests ch:migrate:parser-v9 ch:migrate:l1-retention ch:migrate:analysis-finding-runs ch:migrate:weekly-totals ch:migrate:not-found-unknown ch:migrate:run-question-answers ch:migrate:transcript-search ch:migrate:received-setup ch:migrate:session-saved-outputs ch:migrate:session-images ch:migrate:run-index-messages ch:migrate:run-index-capture-gaps ch:migrate:run-index-approvals ch:migrate:run-activity-end",
		"ch:migrate:github-outcomes": "bun scripts/migrate-github-outcomes.ts"
