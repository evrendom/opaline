{
	"$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"apps/**",
			"packages/**",
			"*.json",
			"!**/generated",
			"!apps/desktop/ui/demo-public/fixtures",
			"!apps/desktop/shell/main.js",
			"!apps/desktop/shell/analyze.js",
			"!apps/desktop/shell/preload.js",
			"!apps/desktop/shell/onboarding-preload.js",
			"!apps/desktop/shell/onboarding-window",
			"!apps/desktop/shell/dots",
			"!apps/desktop/shell/glass3d",
			"!apps/desktop/shell/onboarding",
			"!apps/desktop/shell/icon",
			"!apps/desktop/shell/dmg",
			"!apps/desktop/ui/graphical/generated",
			"!apps/desktop/ui/graphical/install",
			"!apps/desktop/ui/graphical/packages",
			"!apps/desktop/ui/graphical/**/*.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": [
				"packages/api-routes/src/session-transcript/transcript-records/codex-source-*.json",
				"packages/api-routes/src/session-transcript/transcript-records/codex-absence-*.json",
				"packages/api-routes/src/session-transcript/transcript-records/claude-types-*.json"
			],
			"formatter": { "enabled": false }
		},
		{
			"includes": ["apps/desktop/ui/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"radix-ui": "Primitives are Base UI. Use the one in apps/desktop/ui/src/app/ui (see apps/desktop/ui/FRONTEND.md).",
									"lucide-react": "Icons come from @tabler/icons-react only (see apps/desktop/ui/FRONTEND.md)."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"apps/desktop/ui/src/components/analytics/**",
				"apps/desktop/ui/src/components/conversation/**",
				"apps/desktop/ui/src/features/dashboard/DashboardPage.tsx",
				"apps/desktop/ui/src/features/sessions/components/**",
				"apps/desktop/ui/src/features/sessions/reader/**"
			],
			"linter": {
				"rules": {
					"nursery": {
						"noExcessiveLinesPerFile": {
							"level": "error",
							"options": {
								"maxLines": 500,
								"skipBlankLines": true
							}
						}
					},
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"radix-ui": "Primitives are Base UI. Use the one in apps/desktop/ui/src/app/ui (see apps/desktop/ui/FRONTEND.md).",
									"lucide-react": "Icons come from @tabler/icons-react only (see apps/desktop/ui/FRONTEND.md).",
									"react": {
										"importNames": ["useEffect"],
										"message": "Derive state first, then use dedicated hooks like useMountEffect when an effect is still necessary."
									}
								}
							}
						}
					},
					"suspicious": {
						"noDoubleEquals": {
							"level": "error",
							"options": {
								"ignoreNull": false
							}
						}
					}
				}
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
