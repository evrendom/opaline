{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "bun run --cwd apps/web build",
	"bunVersion": "1.x",
	"git": {
		"deploymentEnabled": false
	},
	"framework": "vite",
	"outputDirectory": "apps/web/dist",
	"regions": ["fra1"],
	"functions": {
		"api/cli-connection.ts": {
			"includeFiles": "{apps/api/src/**,packages/*/src/**}",
			"memory": 2048,
			"maxDuration": 300
		},
		"api/rpc.ts": {
			"includeFiles": "{apps/api/src/**,packages/*/src/**}",
			"memory": 2048,
			"maxDuration": 300
		},
		"api/cron/repair.ts": {
			"includeFiles": "{apps/api/src/**,packages/*/src/**}",
			"memory": 2048,
			"maxDuration": 300
		},
		"api/ingest.ts": {
			"includeFiles": "{apps/api/src/**,packages/*/src/**}",
			"memory": 2048,
			"maxDuration": 300
		},
		"api/wrapped.ts": {
			"includeFiles": "{apps/api/src/**,apps/web/dist/index.html,packages/*/src/**}",
			"memory": 2048,
			"maxDuration": 300
		}
	},
	"crons": [
		{
			"path": "/api/cron/repair",
			"schedule": "0 3 * * *"
		}
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Content-Security-Policy",
					"value": "default-src 'self'; base-uri 'self'; connect-src 'self' https://*.posthog.com https://*.chatwoot.com wss://*.chatwoot.com; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; frame-src https://*.chatwoot.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; object-src 'none'; script-src 'self' https://*.posthog.com https://*.chatwoot.com; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
				},
				{
					"key": "Permissions-Policy",
					"value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				},
				{
					"key": "Strict-Transport-Security",
					"value": "max-age=31536000; includeSubDomains"
				},
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "X-Frame-Options",
					"value": "DENY"
				}
			]
		}
	],
	"rewrites": [
		{
			"source": "/api/cli/connections",
			"destination": "/api/cli-connection?__opaline_path=/api/cli/connections"
		},
		{
			"source": "/api/cli/connections/:routePath*",
			"destination": "/api/cli-connection?__opaline_path=/api/cli/connections/:routePath*"
		},
		{
			"source": "/wrapped/:shareId/x-card.png",
			"destination": "/api/wrapped?__opaline_path=/wrapped/:shareId/x-card.png"
		},
		{
			"source": "/wrapped/:shareId",
			"destination": "/api/wrapped?__opaline_path=/wrapped/:shareId"
		},
		{
			"source": "/rpc/ingest/init",
			"destination": "/api/ingest?__opaline_path=/rpc/ingest/init"
		},
		{
			"source": "/rpc/ingest/commit",
			"destination": "/api/ingest?__opaline_path=/rpc/ingest/commit"
		},
		{
			"source": "/rpc/ingest/status",
			"destination": "/api/ingest?__opaline_path=/rpc/ingest/status"
		},
		{
			"source": "/rpc",
			"destination": "/api/rpc?__opaline_path=/rpc"
		},
		{
			"source": "/rpc/:routePath*",
			"destination": "/api/rpc?__opaline_path=/rpc/:routePath*"
		},
		{
			"source": "/health",
			"destination": "/api/rpc?__opaline_path=/health"
		},
		{
			"source": "/api/:routePath((?!cron/repair$).*)",
			"destination": "/api/rpc?__opaline_path=/api/:routePath"
		},
		{
			"source": "/((?!assets(?:/|$)).*)",
			"destination": "/index.html"
		}
	]
}
