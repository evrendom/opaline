{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "bun run build:site",
	"bunVersion": "1.x",
	"git": {
		"deploymentEnabled": false
	},
	"framework": "vite",
	"outputDirectory": "dist-site",
	"regions": ["fra1"],
	"functions": {
		"api/cli-connection.ts": {
			"includeFiles": "{apps/api/src/**,packages/*/src/**}",
			"memory": 2048,
			"maxDuration": 300
		},
		"api/rpc.ts": {
			"includeFiles": "{apps/api/src/**,packages/*/src/**}",
			"memory": 2048,
			"maxDuration": 300
		},
		"api/cron/repair.ts": {
			"includeFiles": "{apps/api/src/**,packages/*/src/**}",
			"memory": 2048,
			"maxDuration": 300
		},
		"api/ingest.ts": {
			"includeFiles": "{apps/api/src/**,packages/*/src/**}",
			"memory": 2048,
			"maxDuration": 300
		},
		"api/invite.ts": {
			"includeFiles": "{apps/api/src/**,apps/web/dist/index.html,packages/*/src/**}",
			"memory": 2048,
			"maxDuration": 300
		},
		"api/demo.ts": {
			"includeFiles": "{apps/api/src/**,packages/*/src/**}",
			"memory": 2048,
			"maxDuration": 300
		}
	},
	"crons": [
		{
			"path": "/api/cron/repair",
			"schedule": "0 3 * * *"
		}
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Permissions-Policy",
					"value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				},
				{
					"key": "Strict-Transport-Security",
					"value": "max-age=31536000; includeSubDomains"
				},
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				}
			]
		},
		{
			"source": "/((?!product-demo(?:/|$)).*)",
			"headers": [
				{
					"key": "Content-Security-Policy",
					"value": "default-src 'self'; base-uri 'self'; connect-src 'self' https://api.github.com https://*.posthog.com https://*.chatwoot.com wss://*.chatwoot.com; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; frame-src 'self' https://*.chatwoot.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; object-src 'none'; script-src 'self' https://*.posthog.com https://*.chatwoot.com; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
				},
				{
					"key": "X-Frame-Options",
					"value": "DENY"
				}
			]
		},
		{
			"source": "/product-demo/(.*)",
			"headers": [
				{
					"key": "Content-Security-Policy",
					"value": "default-src 'self'; base-uri 'self'; connect-src 'self' https://api.github.com https://*.posthog.com https://*.chatwoot.com wss://*.chatwoot.com; font-src 'self' data:; form-action 'self'; frame-ancestors 'self'; frame-src 'self' https://*.chatwoot.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; object-src 'none'; script-src 'self' https://*.posthog.com https://*.chatwoot.com; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
				},
				{
					"key": "X-Frame-Options",
					"value": "SAMEORIGIN"
				}
			]
		}
	],
	"rewrites": [
		{
			"source": "/api/demo/:routePath*",
			"destination": "/api/demo?__opaline_path=/api/demo/:routePath*"
		},
		{
			"source": "/:workspaceSlug/join/:token/og.png",
			"destination": "/api/invite?__opaline_path=/:workspaceSlug/join/:token/og.png"
		},
		{
			"source": "/:workspaceSlug/join/:token",
			"destination": "/api/invite?__opaline_path=/:workspaceSlug/join/:token"
		},
		{
			"source": "/team/invite/:token/og.png",
			"destination": "/api/invite?__opaline_path=/team/invite/:token/og.png"
		},
		{
			"source": "/team/invite/:token",
			"destination": "/api/invite?__opaline_path=/team/invite/:token"
		},
		{
			"source": "/api/cli/connections",
			"destination": "/api/cli-connection?__opaline_path=/api/cli/connections"
		},
		{
			"source": "/api/cli/connections/:routePath*",
			"destination": "/api/cli-connection?__opaline_path=/api/cli/connections/:routePath*"
		},
		{
			"source": "/rpc/ingest/init",
			"destination": "/api/ingest?__opaline_path=/rpc/ingest/init"
		},
		{
			"source": "/rpc/ingest/commit",
			"destination": "/api/ingest?__opaline_path=/rpc/ingest/commit"
		},
		{
			"source": "/rpc/ingest/status",
			"destination": "/api/ingest?__opaline_path=/rpc/ingest/status"
		},
		{
			"source": "/rpc",
			"destination": "/api/rpc?__opaline_path=/rpc"
		},
		{
			"source": "/rpc/:routePath*",
			"destination": "/api/rpc?__opaline_path=/rpc/:routePath*"
		},
		{
			"source": "/health",
			"destination": "/api/rpc?__opaline_path=/health"
		},
		{
			"source": "/health/ready",
			"destination": "/api/rpc?__opaline_path=/health/ready"
		},
		{
			"source": "/api/:routePath((?!cron/repair$).*)",
			"destination": "/api/rpc?__opaline_path=/api/:routePath"
		},
		{
			"source": "/",
			"has": [
				{
					"type": "query",
					"key": "redirect"
				}
			],
			"destination": "/app.html"
		},
		{
			"source": "/",
			"has": [
				{
					"type": "query",
					"key": "user_code"
				}
			],
			"destination": "/app.html"
		},
		{
			"source": "/",
			"has": [
				{
					"type": "query",
					"key": "error"
				}
			],
			"destination": "/app.html"
		},
		{
			"source": "/",
			"has": [
				{ "type": "cookie", "key": "__Secure-better-auth.session_token" }
			],
			"destination": "/api/rpc?__opaline_path=/api/home"
		},
		{
			"source": "/",
			"has": [{ "type": "cookie", "key": "better-auth.session_token" }],
			"destination": "/api/rpc?__opaline_path=/api/home"
		},
		{
			"source": "/home",
			"destination": "/home/index.html"
		},
		{
			"source": "/",
			"destination": "/home/index.html"
		},
		{
			"source": "/((?!assets(?:/|$)|_astro(?:/|$)|product-demo(?:/|$)|site-scripts(?:/|$)|vendor(?:/|$)|fonts(?:/|$)).*)",
			"destination": "/app.html"
		}
	],
	"redirects": [
		{
			"source": "/instant",
			"destination": "/home",
			"permanent": true
		},
		{
			"source": "/instantv2",
			"destination": "/home",
			"permanent": true
		},
		{
			"source": "/get-started",
			"destination": "/welcome",
			"permanent": true
		},
		{
			"source": "/dashboard/get-started",
			"destination": "/welcome",
			"permanent": true
		}
	]
}
