{
	"name": "rudel-monorepo",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"scripts": {
		"build": "turbo run build",
		"benchmark:usage-extraction": "bun scripts/benchmark-usage-extraction.ts",
		"check:disclosure": "bun scripts/check-disclosure.ts",
		"check:design": "bun run --cwd apps/desktop/ui check:design",
		"dev": "turbo run dev",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"pricing:table": "bun ./scripts/generate-model-pricing.ts",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"test:integration": "turbo run test:integration --concurrency=1",
		"test:kill-matrix": "bun apps/desktop/server/src/scripts/kill-matrix/kill-matrix.ts",
		"verify": "bun scripts/check-disclosure.ts && bun run check:design && bun run check-types && turbo run lint test build",
		"dev:local": "bash scripts/dev-local.sh",
		"infra:up": "docker compose -f scripts/dev-compose.yml up -d",
		"infra:down": "docker compose -f scripts/dev-compose.yml down",
		"chkit:link": "bun scripts/chkit-link.ts link",
		"chkit:unlink": "bun scripts/chkit-link.ts unlink",
		"build:selfhost": "bun scripts/build-selfhost.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@playwright/test": "1.61.1",
		"bun-types": "1.3.10",
		"opentype.js": "1.3.4",
		"three": "0.187.0",
		"turbo": "^2.8.9",
		"typescript": "5.9.2"
	},
	"engines": {
		"bun": "1.x",
		"node": ">=18"
	},
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"apps/desktop/*",
		"apps/cli",
		"packages/*"
	],
	"overrides": {
		"chkit": "0.1.0-beta.16",
		"@chkit/core": "0.1.0-beta.16",
		"@chkit/clickhouse": "0.1.0-beta.16",
		"@chkit/codegen": "0.1.0-beta.16",
		"@chkit/plugin-backfill": "0.1.0-beta.16",
		"@chkit/plugin-codegen": "0.1.0-beta.16",
		"@chkit/plugin-obsessiondb": "0.1.0-beta.16",
		"@chkit/plugin-pull": "0.1.0-beta.16",
		"bun-types": "1.3.10",
		"@better-auth/core": "1.6.34",
		"proxy-addr": "2.0.8",
		"tinypool": "2.2.0",
		"vite": "7.3.8"
	},
	"patchedDependencies": {
		"agentation@2.3.3": "patches/agentation@2.3.3.patch",
		"skullet@0.0.3": "patches/skullet@0.0.3.patch"
	}
}
