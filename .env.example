# ============================================================================
# Opaline — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
# ============================================================================

# --- Required ----------------------------------------------------------------

# Postgres connection string (any Postgres)
PG_CONNECTION_STRING=postgres://postgres:postgres@localhost:5432/rudel
# CLI/browser push updates use LISTEN/NOTIFY. Set a direct (non-PgBouncer)
# connection when PG_CONNECTION_STRING is pooled. Neon pooler URLs are converted
# to the matching direct hostname automatically; other providers need this override.
# PG_DIRECT_CONNECTION_STRING=postgres://postgres:postgres@localhost:5432/rudel

# Auth secret used by better-auth for signing tokens/cookies.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Emails allowed to sign in or sign up with a password (comma-separated,
# case-insensitive; * allows everyone). Missing or empty allows nobody; everyone
# else uses email codes or social login.
# PASSWORD_AUTH_EMAILS=

# --- ClickHouse ---------------------------------------------------------------
# For hosted ClickHouse, get credentials at https://obsessiondb.com

# Repository evidence stays enabled unless exactly false; transcript ingest is unaffected.
REPOSITORY_EVIDENCE_CAPTURE_ENABLED=true
# Pause returned to the CLI when disabled; clamped to 3,600–604,800 seconds.
REPOSITORY_EVIDENCE_CAPTURE_PAUSE_SECONDS=86400

# ClickHouse HTTP endpoint. Local Docker uses port 8123; hosted ClickHouse
# endpoints typically serve HTTPS on port 443.
CLICKHOUSE_URL=http://localhost:8123

# ClickHouse credentials. CLICKHOUSE_USERNAME is canonical; CLICKHOUSE_USER is
# accepted as a legacy fallback, and setting both to different values is an
# error. Local Docker default password is "clickhouse".
#
# "default" is the ClickHouse superuser, so it is only assumed for a local
# endpoint. Pointing CLICKHOUSE_URL at a remote host without a username is an
# error rather than a silent fall back to `default`.
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# ClickHouse database name. Used by chkit tooling for schema migrations.
# Not read by the API at runtime (hardcoded to "rudel" in queries).
# CLICKHOUSE_DB=rudel

# Maximum durable attempts for account/workspace ClickHouse cleanup jobs.
# Failed attempts use exponential backoff with jitter. Default: 5
# CLICKHOUSE_PURGE_MAX_ATTEMPTS=5

# Crash-recovery interval for durable ClickHouse purge jobs. Enqueue paths and
# scheduled retries wake the in-process worker sooner. Default: 3600000 (60 min)
# CLICKHOUSE_PURGE_POLL_INTERVAL_MS=3600000
# Delay before the second purge pass that re-deletes after a successful purge,
# closing the race with writers that passed the deletion fence just before it.
# Keep it longer than the longest bounded write. Default: 15 minutes.
# CLICKHOUSE_PURGE_FOLLOWUP_DELAY_MS=900000

# Durable purge polling is enabled by default. Disable only for isolated test
# processes that invoke the worker state machine directly.
# CLICKHOUSE_PURGE_WORKER_ENABLED=true

# --- Direct-to-R2 ingest (optional) ------------------------------------------
# The new multipart protocol is disabled unless all three values are present.
# The API defaults to the EU-jurisdiction endpoint and opaline-ingest-prod.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT= # Test-only loopback endpoint. Ignored unless NODE_ENV=test and
# the host is 127.0.0.1, localhost, or ::1.

# --- GitHub repository evidence (optional) ----------------------------------
# A self-hosted server reads GitHub with a token (GITHUB_TOKEN, GH_TOKEN or the
# GitHub CLI's login; see the self-hosted section below).
# Dark-launch switch for the user-facing GitHub evidence UI (Merged PRs
# dashboard metric and the workspace settings GitHub section). Collection
# and cron run regardless. Only the exact value "true" shows the UI;
# missing or invalid values keep it hidden.
# # Per-org preview override; global kill switch still applies.
GITHUB_EVIDENCE_UI_FORCE_ORG_IDS=
GITHUB_EVIDENCE_UI_ENABLED=false
# Repository-wide data sweep is on by default; exactly false stops its API requests.
# GITHUB_SWEEP_ENABLED=true

# --- Self-hosted server (optional) -----------------------------------------
# Read only by a self-hosted server: bun apps/desktop/server/src/selfhost/main.ts sets
# OPALINE_SELF_HOSTED=1 itself, and `opaline server` sets the connection and
# secret variables. Extra settings for `opaline server` go in
# ~/.opaline/server/server.env.
# OPALINE_SELF_HOSTED=1
# Shared secret (16+ characters) for POST /api/selfhost/setup, which creates the
# owner account, and for setup-token sign-in links.
# OPALINE_SETUP_TOKEN=
# Server files, including the local object store (data/object-store).
# OPALINE_DATA_DIR=
# The built web app (apps/desktop/ui/dist). Unset: the server is API only.
# OPALINE_WEB_DIR=
# What /api/selfhost/info reports as the version (default dev).
# OPALINE_VERSION=
# Listen address (default 127.0.0.1; PORT defaults to 4100 here).
# HOST=127.0.0.1
# auto probes Shared*MergeTree engines and the s3 storage policy; oss or cloud
# skips the probe.
# CLICKHOUSE_FLAVOR=auto
# Sign-up needs a team invite link or an invitation unless this is 1.
# OPALINE_OPEN_SIGNUP=
# Per-workspace limit on sql, run, measures, patterns and search calls per
# hour. Unset: no limit. The hosted service always uses 120 and ignores this.
# OPALINE_SQL_QUOTA_PER_HOUR=
# S3-compatible object storage instead of OPALINE_DATA_DIR/object-store.
# S3_PUBLIC_ENDPOINT is the address CLIs and browsers use when it differs from
# the one the server uses (presigned URLs are signed for it).
# S3_ENDPOINT=http://seaweedfs:8333
# S3_PUBLIC_ENDPOINT=http://nas.local:8333
# S3_BUCKET=opaline
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# GitHub pull requests and CI: a read-only token, read when needed and never
# stored. GITHUB_TOKEN wins over GH_TOKEN; without either the server runs
# `gh auth token` (GH_HOST picks a GitHub Enterprise host, GH_CONFIG_DIR another
# gh configuration). Classic tokens need the repo scope.
# GITHUB_TOKEN=
# GH_TOKEN=
# GH_HOST=github.com
# Days of pull request and CI history read for a new repository (1 to 730).
# OPALINE_GITHUB_HISTORY_DAYS=90

# --- API Server ---------------------------------------------------------------

# Base URL of the API server. Used as better-auth's baseURL and automatically
# added to trusted origins. Default: http://localhost:4010
# APP_URL=http://localhost:4010

# Preferred frontend origin for auth emails and redirects.
# Dev CORS/trusted origins include localhost and 127.0.0.1 on ports 4011-4015
# by default, so either browser hostname works locally.
# Default: http://localhost:4011
# ALLOWED_ORIGIN=http://localhost:4011

# Comma-separated list of trusted origins for better-auth CSRF protection.
# APP_URL is automatically appended.
# TRUSTED_ORIGINS=http://localhost:4011,http://127.0.0.1:4011,http://localhost:4015

# Number of trusted reverse proxies in front of the API, or in front of Fly
# Proxy. Leave at 0 for direct connections and direct Fly deployments.
# TRUSTED_PROXY_HOPS=0

# Server listen port. Default: 4010. Overridden to 3000 in the Docker image.
# PORT=4010

# Directory for static file serving (SPA). Relative to apps/desktop/server/.
# In production, the web app is built and copied to apps/desktop/server/public/.
# Default: public
# STATIC_DIR=public

# Process-wide transcript filtering queue. Limits include the active filtering
# job plus all jobs waiting behind it. Defaults allow two maximum-size
# transcripts globally but only one maximum-size transcript per user.
# INGEST_FILTER_QUEUE_GLOBAL_MAX_BYTES=268435456
# INGEST_FILTER_QUEUE_GLOBAL_MAX_JOBS=8
# INGEST_FILTER_QUEUE_PER_USER_MAX_BYTES=134217728
# INGEST_FILTER_QUEUE_PER_USER_MAX_JOBS=5
# Applies separately to queue wait and active filtering.
# INGEST_FILTER_QUEUE_TIMEOUT_MS=30000

# Atomic Postgres-backed fixed-window ingest caps. API keys receive independent
# counters; legacy bearer authentication keeps one compatibility counter per
# user. Defaults: 15000 requests and 10 GiB per 3600-second window. Both window
# durations must be at least 60 seconds.
# RATE_LIMIT_INGEST_REQUESTS_MAX=15000
# RATE_LIMIT_INGEST_REQUESTS_WINDOW=3600
# RATE_LIMIT_INGEST_BYTES_MAX=10737418240
# RATE_LIMIT_INGEST_BYTES_WINDOW=3600

# Live sessions: the CLI streams a running Claude Code session's transcript
# lines (liveSession.append, stored in R2). On unless LIVE_SESSIONS_ENABLED is
# exactly false (kill switch: CLIs pause for an hour). LIVE_SESSIONS_WORKSPACES
# limits them to comma-separated workspace ids (or *); empty means every
# workspace. Session ingest at session end is unaffected either way.
# LIVE_SESSIONS_ENABLED=true
# LIVE_SESSIONS_WORKSPACES=
# Per-user live update budget, separate from the ingest budget. Defaults: 60000
# requests and 4 GiB of lines per 3600-second window (windows at least 60).
# RATE_LIMIT_LIVE_SESSION_REQUESTS_MAX=60000
# RATE_LIMIT_LIVE_SESSION_REQUESTS_WINDOW=3600
# RATE_LIMIT_LIVE_SESSION_BYTES_MAX=4294967296
# RATE_LIMIT_LIVE_SESSION_BYTES_WINDOW=3600

# Request-level analytics cutover. Missing or invalid modes are treated as off.
# In canary mode, an empty organization list also remains off.
# USAGE_EVENT_ANALYTICS_CUTOVER_MODE=off
# USAGE_EVENT_ANALYTICS_CANARY_ORG_IDS=org-id-1,org-id-2
# Workspaces priced from per-session usage rollups once every session has a
# current one. Unset or "all": every workspace; "none": none; else a list.
# USAGE_ROLLUP_ORG_IDS=all
# Persist skill uses and complete bodies while ingesting. Default: true.
# SKILL_EXTRACTION_ENABLED=true
# Persistent skill-read cutover. Missing/invalid values fail closed to the
# temporary legacy reader; canary mode requires at least one workspace ID.
# SKILL_ANALYTICS_CUTOVER_MODE=off
# SKILL_ANALYTICS_CANARY_ORG_IDS=org-id-1,org-id-2
# Preview/execute skill backfill safety bounds.
# SKILL_BACKFILL_MAX_SESSIONS=10000
# SKILL_BACKFILL_MAX_SESSION_BYTES=536870912
# SKILL_BACKFILL_BATCH_MAX_ROWS=64
# Index every transcript record in rudel.transcript_records while ingesting.
# Best-effort: failures are logged and never fail an upload. Default: true.
# TRANSCRIPT_RECORDS_EXTRACTION_ENABLED=true
# GIT_OBSERVATION_EXTRACTION_ENABLED=true
# L1 edges (docs/adr/0003-l1-evidence-entities-edges.md): requests are queued
# after extraction unless L1_EDGES_ENQUEUE_ENABLED=false; the worker builds them
# only when L1_EDGES_WORKER_ENABLED=true. Default: queue on, worker off.
# L1_EDGES_ENQUEUE_ENABLED=true
# L1_EDGES_WORKER_ENABLED=false
# Per-record text cap and per-session text budget, in characters.
# TRANSCRIPT_RECORDS_TEXT_MAX_CHARS=65536
# TRANSCRIPT_RECORDS_SESSION_TEXT_BUDGET_CHARS=33554432
# Extraction runs in its own worker under these per-process bounds: concurrent
# jobs, raw transcript bytes in flight, records one session may expand to, and
# the wall-clock budget per session in milliseconds. Jobs beyond them are skipped.
# TRANSCRIPT_RECORDS_QUEUE_MAX_JOBS=2
# TRANSCRIPT_RECORDS_QUEUE_MAX_BYTES=268435456
# TRANSCRIPT_RECORDS_MAX_ROWS=1000000
# TRANSCRIPT_RECORDS_TIMEOUT_MS=120000
# Preview/execute transcript-records backfill safety bounds.
# TRANSCRIPT_RECORDS_BACKFILL_MAX_SESSIONS=10000
# TRANSCRIPT_RECORDS_BACKFILL_MAX_SESSION_BYTES=536870912
# TRANSCRIPT_RECORDS_BACKFILL_BATCH_MAX_ROWS=64
# TRANSCRIPT_RECORDS_BACKFILL_BATCH_MAX_BYTES=134217728
# SKILL_BACKFILL_BATCH_MAX_BYTES=134217728
# SESSION_INGEST_QUIESCED=false # Set true before the token-counting rebuild.

# Persisted session language-signal reconciliation.
# LANGUAGE_SIGNAL_RECONCILE_INTERVAL_MS=60000
# LANGUAGE_SIGNAL_RECONCILE_BATCH_SIZE=25

# Browser verification URL shown by the Opaline CLI device-code flow.
# Local dev should point at the Vite web app. Default:
# http://localhost:4011/welcome
# CLI_DEVICE_VERIFICATION_URL=http://localhost:4011/welcome

# --- CLI ----------------------------------------------------------------------

# CLI API target. Production CLI defaults to https://opaline.so.
# Local dev can point the CLI at the local API without changing saved prod creds:
# RUDEL_CONFIG_DIR=.context/rudel-local-cli RUDEL_API_BASE=http://localhost:4010 rudel login
# RUDEL_API_BASE=http://localhost:4010
# Plaintext non-loopback upload destinations require their own explicit opt-in:
# RUDEL_ALLOW_INSECURE_ENDPOINT=1

# --- OAuth Providers (optional) -----------------------------------------------
# Enable social login by providing OAuth credentials. If not set, only
# email/password authentication is available.

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Integrations (optional) --------------------------------------------------

# Frontend API origin. Defaults to the current browser origin when unset.
# VITE_API_BASE_URL=http://localhost:4010

# Slack incoming webhook URL. When set, sends a notification to the channel
# on every new user signup.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Resend email integration.
# RESEND_API_KEY=
# Automatic emails are sent as Opaline <evren@opaline.so>.
# RESEND_AUDIENCE_ID=

# Optional recipient for terminal ClickHouse purge failure alerts.
# Alerts are disabled when unset.
# CLICKHOUSE_PURGE_ALERT_RECIPIENT=operator@example.com

# Request-time session-detail derivation is a launch bridge. The defaults are
# sized for the production 2 GB VM envelope; oversized entries remain uncached.
# SESSION_DETAIL_DERIVATION_CACHE_MAX_BYTES=268435456
# SESSION_DETAIL_DERIVATION_CACHE_MAX_ENTRY_BYTES=67108864
# Local-only frontend fixture mode for UI/routing work while analytics endpoints
# are unstable. Ignored in production builds because it is gated by import.meta.env.DEV.
# VITE_FRONTEND_FIXTURES=0

# Server-only, read-only showcase proxy. Never use VITE_ for these.
DEMO_ACCOUNT_EMAIL=
DEMO_ORGANIZATION_ID=

# Optional analysis log. Unset keeps logging off; memory needs no deployment.
# Keep analyses in this Postgres (self-hosted servers do by default):
# ANALYSIS_LOG_PURGE_BACKENDS=postgres
# ANALYSIS_LOG_STORE=postgres
# Only these workspaces are captured and may use history (comma-separated ids,
# * = every workspace, empty = nobody).
# ANALYSIS_LOG_WORKSPACES=
# Shared analyses show stored results to the whole workspace; these workspaces,
# when limited to own sessions (organization.own_sessions_only), restrict each
# result to admins and the member whose sessions it read.
# ANALYSIS_LOG_RESTRICTED_WORKSPACES=

# Retro tools (schema, sql, search, run, estimate_questions, run_questions):
# VITE_ADMIN_ORGANIZATION_ID always; the workspaces listed here (comma-separated
# ids, * = every workspace); and every workspace created on or after
# RETRO_TOOLS_NEW_SINCE (ISO date, UTC; unset = no date rule; invalid is logged
# and adds nobody). Others are told to use find and read.
# RETRO_TOOLS_WORKSPACES=
# RETRO_TOOLS_NEW_SINCE=2026-11-06

# Run questions (precomputed answers, estimate_questions, run_questions and the
# /admin/run-questions form). SubQ Snap answers once its key is set; without a
# key nothing is answered or sent anywhere. In the workspaces allowed below,
# every new run is answered for every question that is on once it is indexed
# (history: bun run backfill:run-questions in apps/desktop/server). Providers, the first
# answering agents (default subq; jev is a fallback; :note or :run choose what
# they read):
# RUN_QUESTIONS_PROVIDER=subq
# SUBQ_API_KEY=
# SUBQ_USD_PER_MILLION_INPUT_TOKENS=0.05
# SUBQ_USD_PER_MILLION_OUTPUT_TOKENS=0
# Jev (Typesafe) publishes no prices, so both are required to use it.
# TYPESAFE_API_KEY=
# TYPESAFE_USD_PER_MILLION_INPUT_TOKENS=
# TYPESAFE_USD_PER_MILLION_OUTPUT_TOKENS=
# Workspaces besides VITE_ADMIN_ORGANIZATION_ID whose runs may be sent
# (comma-separated ids; Opaline's own data workspaces).
# RUN_QUESTIONS_INTERNAL_WORKSPACES=
# Exactly true lets customer workspaces have run questions answered. Leave off
# until the provider's data-retention and subprocessor terms are checked.
# RUN_QUESTIONS_CUSTOMER_WORKSPACES=
# Workspaces whose dashboard shows the answers as tags, in the sessions list
# and the reader (comma-separated ids, * = every workspace whose runs are
# answered). Unset or empty: only VITE_ADMIN_ORGANIZATION_ID.
# RUN_QUESTION_TAGS_WORKSPACES=
# Workspaces that may open the Agent traces page (comma-separated ids, * =
# every workspace). Unset or empty: nobody. /admin/features overrides it per
# workspace without a redeploy.
# AGENT_TRACES_WORKSPACES=
# Workspaces with Compass (moments and patterns), and those
# whose members may observe a moment with Claude (sends that moment's records
# to Anthropic). Comma-separated ids, * = every workspace; unset: nobody.
# /admin/features overrides both per workspace.
# MOMENTS_WORKSPACES=
# MOMENT_OBSERVATIONS_WORKSPACES=
# Workspaces whose member prompts SubQ checks for frustration (Compass's User
# frustrated flag; sends each prompt after a run, with the agent's last message,
# to SubQ; needs SUBQ_API_KEY). Unset: nobody.
# FRUSTRATION_CHECK_WORKSPACES=
# Observations need an Anthropic key; model and per-workspace daily limit.
# ANTHROPIC_API_KEY=
# MOMENT_OBSERVATIONS_MODEL=claude-opus-5-5
# MOMENT_OBSERVATIONS_DAILY_LIMIT=100

# Transcript search: these workspaces are indexed and embedded with OpenAI
# text-embedding-3-small when OPENAI_API_KEY is set
# (comma-separated ids, * = every workspace, empty = none).
# TRANSCRIPT_EMBEDDINGS_WORKSPACES=
# Tokens each workspace may embed per 30 days (default 1000000000, about $20).
# TRANSCRIPT_EMBEDDINGS_QUOTA_TOKENS=
