# See root .env.example for full documentation of all variables.

# Required
PG_CONNECTION_STRING=postgres://postgres:postgres@localhost:5432/rudel
BETTER_AUTH_SECRET=
# Password sign-in allowlist (comma-separated emails, * for everyone).
# PASSWORD_AUTH_EMAILS=*

# Local frontend origin used for auth links. Dev CORS/trusted origins include
# localhost and 127.0.0.1 on ports 4011-4015 by default.
# ALLOWED_ORIGIN=http://localhost:4011
# TRUSTED_ORIGINS=http://localhost:4011,http://127.0.0.1:4011,http://localhost:4015

# Number of trusted reverse proxies in front of the API, or in front of Fly
# Proxy. Leave at 0 for direct connections and direct Fly deployments.
# TRUSTED_PROXY_HOPS=0
# CRON_SECRET=replace-with-at-least-16-random-characters

# Process-wide transcript filtering queue. Limits include active work.
# INGEST_FILTER_QUEUE_GLOBAL_MAX_BYTES=268435456
# INGEST_FILTER_QUEUE_GLOBAL_MAX_JOBS=8
# INGEST_FILTER_QUEUE_PER_USER_MAX_BYTES=134217728
# INGEST_FILTER_QUEUE_PER_USER_MAX_JOBS=5
# Applies separately to queue wait and active filtering.
# INGEST_FILTER_QUEUE_TIMEOUT_MS=30000
# SESSION_INGEST_QUIESCED=false # Set true before the token-counting rebuild.
# SESSION_INGEST_OPERATOR_TOKEN= # Operator-only bypass while quiesced; send it in x-rudel-session-ingest-operator-token.

# ClickHouse (get hosted credentials at https://obsessiondb.com)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
# CLICKHOUSE_PURGE_MAX_ATTEMPTS=5
# CLICKHOUSE_PURGE_POLL_INTERVAL_MS=3600000
# CLICKHOUSE_PURGE_FOLLOWUP_DELAY_MS=900000
# CLICKHOUSE_PURGE_WORKER_ENABLED=true

# Direct-to-R2 multipart ingest. Disabled unless all three are present.
# Uses https://<account>.eu.r2.cloudflarestorage.com and opaline-ingest-prod.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT= # Test-only loopback endpoint. Ignored unless NODE_ENV=test and
# the host is 127.0.0.1, localhost, or ::1.

# Read-only GitHub App for repository evidence. The PEM may use escaped \\n.
# Hosted service only: a self-hosted server (OPALINE_SELF_HOSTED=1) ignores these
# and reads GitHub with GITHUB_TOKEN, GH_TOKEN or `gh auth token` instead.
# GITHUB_REPOSITORY_APP_ID=
# GITHUB_REPOSITORY_APP_SLUG=
# GITHUB_REPOSITORY_APP_PRIVATE_KEY=
# GitHub App user authorization verifies that the workspace administrator can
# access the installation before it is bound. Use this exact URL as both the
# App Setup URL and an OAuth callback URL.
# GITHUB_REPOSITORY_APP_CLIENT_ID=
# GITHUB_REPOSITORY_APP_CLIENT_SECRET=
# GITHUB_REPOSITORY_APP_CALLBACK_URL=https://api.opaline.so/api/github/setup
# GITHUB_REPOSITORY_APP_STATE_SECRET= # Optional; falls back to BETTER_AUTH_SECRET.
# GITHUB_REPOSITORY_APP_WEBHOOK_SECRET= # Optional 32+ chars; enables /api/webhooks/github.
# Show the dark-launched GitHub evidence UI (Merged PRs metric, settings GitHub
# section). Only "true" enables it; collection keeps running either way.
# GITHUB_EVIDENCE_UI_ENABLED=false
# Cross-provider session lineage (off until the schema is migrated and a
# stable, 32+ character fingerprint key is configured).
# SESSION_LINEAGE_ENABLED=false
# SESSION_LINEAGE_CONSUMERS_ENABLED=false
# SESSION_LINEAGE_FINGERPRINT_KEY=
# SESSION_LINEAGE_RECONCILE_INTERVAL_MS=60000
# SESSION_LINEAGE_RECONCILE_BATCH_SIZE=25

# OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Slack notifications (optional)
# SLACK_WEBHOOK_URL=

# Attio CRM (optional). Syncs signups and Customer 360 workspaces.
# Requires record_permission:read-write and object_configuration:read-write scopes.
# ATTIO_ACCESS_TOKEN=

# CLI device-code browser verification URL.
# CLI_DEVICE_VERIFICATION_URL=http://localhost:4011/welcome

# Resend email (optional)
# RESEND_API_KEY=
# Automatic emails are sent as Opaline <notifications@mail.opaline.so>, replies to evren@opaline.so.
# RESEND_AUDIENCE_ID=    # Optional: sync new signups to a Resend audience
# CLICKHOUSE_PURGE_ALERT_RECIPIENT=operator@example.com # Optional: terminal purge alerts
#
# PostHog product analytics (optional)
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_ENABLED=false
# PRODUCT_ANALYTICS_EXCLUDED_ORG_IDS=
# Stripe server-side billing. Register /api/webhooks/stripe for
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.expired, invoice.payment_action_required,
# customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, customer.subscription.pending_update_applied,
# customer.subscription.pending_update_expired, customer.updated, invoice.paid,
# invoice.payment_succeeded, invoice.payment_action_required,
# invoice.payment_failed, and invoice.finalization_failed.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Required when Stripe is configured: sandbox or live.
# STRIPE_BILLING_MODE=sandbox
# Recurring, per-member Stripe Price IDs used by server-created Checkout.
# STRIPE_PRICE_BASIC_MONTHLY=
# STRIPE_PRICE_BASIC_YEARLY=
# STRIPE_PRICE_BUSINESS_MONTHLY=
# STRIPE_PRICE_BUSINESS_YEARLY=

# Server error monitoring. Both the flag and DSN are required; otherwise the
# Sentry Node SDK remains unloaded and error delivery is a no-op.
# SENTRY_API_ENABLED=false
# SENTRY_API_DSN=
# SENTRY_ENVIRONMENT=development

# Server-only, read-only showcase proxy. Never use VITE_ for these.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=
DEMO_ORGANIZATION_ID=
