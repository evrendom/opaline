{
	"name": "@opalinehq/cli",
	"version": "0.18.0",
	"type": "module",
	"description": "Retired: removes the Opaline CLI's upload hooks and saved sign-in. Opaline is now a free Mac app.",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=20"
	},
	"homepage": "https://opaline.evren.so",
	"repository": {
