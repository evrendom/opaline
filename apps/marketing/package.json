{
	"name": "@rudel/marketing",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "bun ../../scripts/trends/build-marketing.ts",
		"preview": "astro preview",
		"preview:product": "bun ../../scripts/preview-site.ts",
		"dev:product": "bun run --cwd ../.. build:site && bun ../../scripts/preview-site.ts",
		"test:product-demo": "bun test tests/product-demo.test.ts tests/safari-demo-motion.test.ts && bun test ../web/tools/product-demo-parity.test.ts",
		"test:landing": "bun test tests/landing-motion.test.js tests/landing-canvas.test.js tests/landing-canvas-precision.test.js tests/hero-canvas.test.js",
		"test:product-demo-parity": "bun test ../web/tools/product-demo-parity.test.ts",
		"test:product-demo-explore": "bun test ../web/tools/product-demo-explore.test.ts",
		"test:cli-onboarding": "bun test tests/cli-authorization.test.ts",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/react": "6.0.3",
		"astro": "7.0.3",
		"glimm": "0.1.4",
		"lenis": "1.3.26",
		"motion": "^12.38.0",
		"posthog-js": "1.407.5",
		"react": "19.2.4",
		"react-dom": "19.2.4"
	},
	"devDependencies": {
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3"
	}
}
