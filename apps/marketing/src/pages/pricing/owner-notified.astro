---
import InstantV2Nav from "../../components/InstantV2Nav.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout
	title="Upgrade request sent — Opaline"
	description="Your Opaline workspace owner has been notified about your upgrade request."
	canonical="/pricing/owner-notified"
>
	<InstantV2Nav filled />
	<main class="owner-notified-page">
		<section class="owner-notified-content" aria-labelledby="owner-notified-title">
			<h1 id="owner-notified-title">We’ve notified your workspace owner.</h1>
			<p class="owner-notified-description">
				They’ll get an email with a secure link to review the upgrade.
			</p>
			<div class="owner-notified-actions">
				<a class="owner-notified-primary" href="/api/home">Back to workspace</a>
				<a class="owner-notified-secondary" href="/pricing/">Review plans</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	:global(body) {
		background: var(--landing-page);
	}

	.owner-notified-page {
		position: relative;
		isolation: isolate;
		display: grid;
		min-height: calc(100svh - 42px);
		place-items: center;
		overflow: hidden;
		padding: 96px 24px;
	}

	.owner-notified-content {
		display: flex;
		width: min(100%, 640px);
		flex-direction: column;
		align-items: center;
		gap: 0;
		text-align: center;
	}

	.owner-notified-content h1 {
		max-width: 18ch;
		margin: 0;
		color: var(--landing-ink);
		font-size: 52px;
		font-weight: 600;
		letter-spacing: -0.045em;
		line-height: 1.04;
		text-wrap: balance;
	}

	.owner-notified-description {
		max-width: 38ch;
		margin: 24px 0 0;
		color: var(--landing-ink-secondary);
		font-size: 16px;
		line-height: 1.6;
		text-wrap: pretty;
	}

	.owner-notified-actions {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-top: 32px;
	}

	.owner-notified-primary,
	.owner-notified-secondary {
		display: inline-flex;
		height: 36px;
		align-items: center;
		justify-content: center;
		padding: 0 12px;
		border-radius: 8px;
		font-size: 13px;
		font-weight: 500;
		text-decoration: none;
	}

	.owner-notified-primary {
		background: var(--landing-primary);
		color: var(--landing-primary-ink);
	}

	.owner-notified-secondary {
		background: var(--landing-control);
		box-shadow: var(--owner-notified-secondary-shadow);
		color: var(--landing-ink);
	}

	:global(html) {
		--owner-notified-secondary-shadow:
			inset 0 0 0 0.5px rgba(0, 0, 0, 0.12), 0 1px 2px rgba(0, 0, 0, 0.05);
	}

	:global(html.dark) {
		--owner-notified-secondary-shadow: var(--landing-control-shadow);
	}

	@media (any-hover: hover) {
		.owner-notified-primary:hover {
			background: var(--landing-primary);
		}

		.owner-notified-secondary:hover {
			background: var(--landing-control-pressed);
		}
	}

	.owner-notified-primary:focus-visible,
	.owner-notified-secondary:focus-visible {
		outline: 2px solid #3b82f6;
		outline-offset: 2px;
	}

	@media (max-width: 720px) {
		.owner-notified-page {
			padding: 88px 20px 48px;
		}

		.owner-notified-content h1 {
			font-size: 40px;
		}

		.owner-notified-description {
			margin-top: 22px;
			font-size: 16px;
		}

		.owner-notified-actions {
			width: 100%;
			flex-direction: column;
			margin-top: 30px;
		}

		.owner-notified-primary,
		.owner-notified-secondary {
			width: 100%;
			min-height: 48px;
			font-size: 16px;
		}
	}
</style>
