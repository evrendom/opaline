---
import { OPALINE_OUTLINE } from "../../../web/src/features/shell/components/opaline-outline";
import InstantV2Nav from "../components/InstantV2Nav.astro";
import Layout from "../layouts/Layout.astro";
import { DESKTOP_DOWNLOAD_URLS } from "../scripts/desktop-download";

const defaultDownloadUrl = DESKTOP_DOWNLOAD_URLS.arm64;

const dockLeft = [
	{ tint: "oklch(0.72 0.03 250)", blur: 3 },
	{ tint: "oklch(0.78 0.02 80)" },
	{ tint: "oklch(0.7 0.04 150)", blur: 1.7 },
	{ tint: "oklch(0.8 0.03 95)", blur: 1.3 },
];

const dockRight = [
	{ tint: "oklch(0.7 0.03 220)" },
	{ tint: "oklch(0.74 0.04 300)" },
	{ tint: "oklch(0.68 0.02 200)" },
	{ tint: "oklch(0.76 0.03 30)" },
];
---

<Layout
	title="Thanks for downloading Opaline"
	description="Your Opaline download is on its way. Here is what to do next."
	canonical="/download/"
	noindex
>
	<InstantV2Nav filled download={false} />
	<main
		class="download-page"
		data-download-arm64={DESKTOP_DOWNLOAD_URLS.arm64}
		data-download-x64={DESKTOP_DOWNLOAD_URLS.x64}
	>
		<section class="download-hero" aria-labelledby="download-title">
			<div class="download-dock" aria-hidden="true">
				<div class="download-dock-shelf">
					<span class="download-dock-glass" data-liquid-glass="dock"></span>
					<span class="glass-rim"></span>
					{
						dockLeft.map((app) => (
							<span
								class="download-dock-icon download-dock-tile"
								style={`--tile: ${app.tint};${"blur" in app ? ` filter: blur(${app.blur}px); opacity: 0.5` : ""}`}
							/>
						))
					}
					<div class="download-dock-opaline">
						<img
							class="download-dock-icon download-dock-icon-opaline"
							src="/images/dock/opaline-dark@2x.png"
							srcset="/images/dock/opaline-dark@1x.png 1x, /images/dock/opaline-dark@2x.png 2x, /images/dock/opaline-dark@3x.png 3x"
							alt=""
							width="91"
							height="91"
							loading="eager"
						/>
						<span class="download-dock-dot"></span>
					</div>
					{
						dockRight.map((app) => (
							<span
								class="download-dock-icon download-dock-tile"
								style={`--tile: ${app.tint};${"blur" in app ? ` filter: blur(${app.blur}px); opacity: 0.5` : ""}`}
							/>
						))
					}
				</div>
			</div>
			{
				defaultDownloadUrl ? (
					<div class="download-intro">
						<h1 id="download-title">
							Thanks for downloading!<br />Just a few steps left
						</h1>
						<p class="download-status">
							Your download will begin automatically.<br />If it didn’t
							start,{" "}
							<a
								href={defaultDownloadUrl}
								data-desktop-download
								data-marketing-download-source="download_page_retry"
							>
								download Opaline manually
							</a>
							.
						</p>
					</div>
				) : (
					<div class="download-intro">
						<h1 id="download-title">
							Thanks for downloading!<br />Just a few steps left
						</h1>
						<p class="download-status">
							The download link isn’t live yet. Check back soon.
						</p>
					</div>
				)
			}
		</section>

		<ol class="download-steps" aria-label="What to do next">
			<li class="download-step">
				<div class="step-art step-art-downloads" aria-hidden="true">
					<div class="art-dock">
						<img src="/images/download-steps/app-notes-dock@2x.png" srcset="/images/download-steps/app-notes-dock@2x.png 2x, /images/download-steps/app-notes-dock@3x.png 3x" alt="" width="48" height="48" />
						<span class="art-dock-divider"></span>
						<span class="art-dock-slot">
							<span class="art-tip">
								<span class="art-tip-glass" data-liquid-glass="tip">
								<svg class="art-tip-check" viewBox="0 0 16 16">
									<circle cx="8" cy="8" r="7" fill="currentColor"></circle>
									<path
										d="M5 8.25 7 10.25 11 6"
										fill="none"
										stroke="#0b0b0b"
										stroke-width="1.6"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
								Download started
									<span class="glass-rim"></span>
								</span>
								<svg class="art-tip-tail" viewBox="0 0 16 7.5">
									<path
										class="art-tip-tail-fill"
										d="M0 0h16c-2.7 0-4.2 1.4-5.4 3.6C9.9 5 9.1 6.3 8 6.3S6.1 5 5.4 3.6C4.2 1.4 2.7 0 0 0z"></path>
								</svg>
							</span>
							<span class="art-file">
								<img src="/images/download-steps/dmg@2x.png" srcset="/images/download-steps/dmg@2x.png 2x, /images/download-steps/dmg@3x.png 3x" alt="" width="52" height="52" />
								<span class="art-progress"><span class="art-progress-fill"></span></span>
							</span>
							<img class="art-cursor art-cursor-arrow" src="/images/download-steps/cursor-arrow@2x.png" srcset="/images/download-steps/cursor-arrow@2x.png 2x, /images/download-steps/cursor-arrow@3x.png 3x" alt="" width="28" height="40" />
						</span>
						<img src="/images/download-steps/trash@2x.png" srcset="/images/download-steps/trash@2x.png 2x, /images/download-steps/trash@3x.png 3x" alt="" width="52" height="52" />
					</div>
				</div>
				<p class="step-caption">
				<span class="step-pebble" aria-hidden="true">
					<svg viewBox="0 0 1049 1042">
						<clipPath id="step-pebble-1"><path d={OPALINE_OUTLINE}></path></clipPath>
						<path class="step-pebble-fill" d={OPALINE_OUTLINE}></path>
						<path
							class="step-pebble-ring"
							d={OPALINE_OUTLINE}
							clip-path="url(#step-pebble-1)"
							vector-effect="non-scaling-stroke"></path>
					</svg>
					<span class="step-pebble-number">1</span>
				</span>Open <strong>Opaline.dmg</strong> from your <strong>Downloads</strong> folder
				</p>
			</li>
			<li class="download-step">
				<div class="step-art step-art-drag" aria-hidden="true">
					<span class="art-drag-app">
						<img src="/images/download-steps/opaline-tilted@2x.png" srcset="/images/download-steps/opaline-tilted@2x.png 2x, /images/download-steps/opaline-tilted@3x.png 3x" alt="" width="80" height="80" />
						<img class="art-cursor art-cursor-hand" src="/images/download-steps/cursor-hand@2x.png" srcset="/images/download-steps/cursor-hand@2x.png 2x, /images/download-steps/cursor-hand@3x.png 3x" alt="" width="32" height="32" />
					</span>
					<span class="art-drop">
						<img src="/images/download-steps/applications@2x.png" srcset="/images/download-steps/applications@2x.png 2x, /images/download-steps/applications@3x.png 3x" alt="" width="88" height="88" />
						<svg class="art-alias" viewBox="0 0 16 16">
							<path d="M4.5 12.5V9.75A3.25 3.25 0 0 1 7.75 6.5h3.5"></path>
							<path d="M9 4l2.5 2.5L9 9"></path>
						</svg>
					</span>
				</div>
				<p class="step-caption">
				<span class="step-pebble" aria-hidden="true">
					<svg viewBox="0 0 1049 1042">
						<clipPath id="step-pebble-2"><path d={OPALINE_OUTLINE}></path></clipPath>
						<path class="step-pebble-fill" d={OPALINE_OUTLINE}></path>
						<path
							class="step-pebble-ring"
							d={OPALINE_OUTLINE}
							clip-path="url(#step-pebble-2)"
							vector-effect="non-scaling-stroke"></path>
					</svg>
					<span class="step-pebble-number">2</span>
				</span>Drag the <strong>Opaline</strong> icon into your <strong>Applications</strong> folder
				</p>
			</li>
			<li class="download-step">
				<div class="step-art step-art-finder" aria-hidden="true">
					<div class="art-finder">
						<div class="art-finder-bar">
							<img src="/images/download-steps/folder-applications@2x.png" srcset="/images/download-steps/folder-applications@2x.png 2x, /images/download-steps/folder-applications@3x.png 3x" alt="" width="16" height="16" />
							<span>Applications</span>
						</div>
						<div class="art-finder-grid">
							<span class="art-finder-item">
								<span class="art-finder-icon"><img src="/images/download-steps/app-notes-dock@2x.png" srcset="/images/download-steps/app-notes-dock@2x.png 2x, /images/download-steps/app-notes-dock@3x.png 3x" alt="" width="48" height="48" /></span>
								<span class="art-finder-label">Notes</span>
							</span>
							<span class="art-finder-item is-selected">
								<span class="art-finder-icon"><img src="/images/download-steps/opaline-48@2x.png" srcset="/images/download-steps/opaline-48@2x.png 2x, /images/download-steps/opaline-48@3x.png 3x" alt="" width="48" height="48" /></span>
								<span class="art-finder-label">Opaline</span>
								<img class="art-cursor art-cursor-arrow" src="/images/download-steps/cursor-arrow@2x.png" srcset="/images/download-steps/cursor-arrow@2x.png 2x, /images/download-steps/cursor-arrow@3x.png 3x" alt="" width="28" height="40" />
							</span>
						</div>
					</div>
				</div>
				<p class="step-caption">
				<span class="step-pebble" aria-hidden="true">
					<svg viewBox="0 0 1049 1042">
						<clipPath id="step-pebble-3"><path d={OPALINE_OUTLINE}></path></clipPath>
						<path class="step-pebble-fill" d={OPALINE_OUTLINE}></path>
						<path
							class="step-pebble-ring"
							d={OPALINE_OUTLINE}
							clip-path="url(#step-pebble-3)"
							vector-effect="non-scaling-stroke"></path>
					</svg>
					<span class="step-pebble-number">3</span>
				</span>Open <strong>Opaline</strong> from your <strong>Applications</strong> folder
				</p>
			</li>
		</ol>

	</main>
</Layout>

<script>
	import { detectMacArchitecture } from "../scripts/desktop-download";
	import { applyGlass } from "../scripts/liquid-glass";

	const GLASS = {
		dock: { radius: 26, depth: 16, curvature: 40, scale: 0.1, chroma: 0.2 },
		tip: { radius: 15, depth: 9, curvature: 40, scale: 0.1, chroma: 0.2 },
	};
	for (const element of document.querySelectorAll<HTMLElement>(
		"[data-liquid-glass]",
	)) {
		const kind = element.dataset.liquidGlass as keyof typeof GLASS;
		if (GLASS[kind]) applyGlass(element, GLASS[kind]);
	}

	const BOUNCE_MS = 700;
	const opaline = document.querySelector<HTMLElement>(
		".download-dock-opaline",
	);
	const opalineIcon = opaline?.querySelector<HTMLElement>(
		".download-dock-icon-opaline",
	);
	const canHover = window.matchMedia(
		"(any-hover: hover) and (prefers-reduced-motion: no-preference)",
	).matches;
	if (opaline && opalineIcon && canHover) {
		let stopTimer = 0;
		opaline.addEventListener("pointerenter", () => {
			window.clearTimeout(stopTimer);
			opaline.dataset.bouncing = "";
		});
		opaline.addEventListener("pointerleave", () => {
			const elapsed =
				Number(opalineIcon.getAnimations()[0]?.currentTime ?? 0) % BOUNCE_MS;
			const remaining = elapsed > 0 ? BOUNCE_MS - elapsed : 0;
			stopTimer = window.setTimeout(() => {
				delete opaline.dataset.bouncing;
			}, remaining);
		});
	}

	const page = document.querySelector<HTMLElement>(".download-page");
	const link = document.querySelector<HTMLAnchorElement>(
		"[data-desktop-download]",
	);
	if (page && link) {
		void detectMacArchitecture().then((architecture) => {
			const url =
				architecture === "x64"
					? page.dataset.downloadX64
					: page.dataset.downloadArm64;
			if (!url) return;
			link.href = url;
			window.setTimeout(() => {
				page.dataset.downloading = "";
				window.location.assign(url);
			}, 400);
		});
	}
</script>

<style>
	:global(html),
	:global(body) {
		overscroll-behavior: none;
	}

	:global(body) {
		background: var(--landing-page);
	}

	.download-page {
		display: flex;
		min-height: calc(100svh - 42px);
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: clamp(30px, 10.5svh, 120px);
		padding: clamp(8px, 2svh, 32px) 24px clamp(16px, 3svh, 40px);
	}

	.download-hero {
		display: flex;
		width: 100%;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.download-dock {
		display: flex;
		width: min(100%, 774px);
		justify-content: center;
		margin-bottom: clamp(24px, 8.5svh, 96px);
		padding-top: 32px;
		overflow-x: clip;
		mask-image: linear-gradient(
			90deg,
			transparent,
			rgb(0 0 0 / 0.35) 14%,
			#000 38%,
			#000 62%,
			rgb(0 0 0 / 0.35) 86%,
			transparent
		);
	}

	.download-dock-shelf {
		position: relative;
		display: flex;
		flex: none;
		align-items: flex-end;
		padding: 4px 9px;
		border-radius: 26px;
		box-shadow: 0 18px 40px -12px rgb(0 0 0 / 0.6);
	}

	.download-dock-glass,
	.download-dock-shelf > .glass-rim {
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.download-dock-glass {
		background:
			radial-gradient(
				70% 140% at 50% 0%,
				rgb(255 255 255 / 0.13),
				transparent 62%
			),
			linear-gradient(180deg, rgb(38 38 42), rgb(20 20 23));
	}

	.download-dock-shelf > :not(.download-dock-glass, .glass-rim) {
		position: relative;
		z-index: 1;
	}

	.glass-rim {
		position: absolute;
		inset: 0;
		padding: 1px;
		border-radius: inherit;
		background: linear-gradient(
			135deg,
			rgb(255 255 255 / 0.55),
			rgb(255 255 255 / 0.08) 28%,
			rgb(255 255 255 / 0.04) 70%,
			rgb(255 255 255 / 0.32)
		);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(#000 0 0) content-box exclude,
			linear-gradient(#000 0 0);
		pointer-events: none;
	}


	.download-dock-opaline {
		position: relative;
		z-index: 1;
	}

	.download-dock-opaline[data-bouncing] .download-dock-icon-opaline {
		animation: download-dock-launch 0.7s infinite;
	}

	.download-dock-dot {
		position: absolute;
		bottom: -1px;
		left: 50%;
		width: 4px;
		height: 4px;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.72);
		transform: translateX(-50%);
	}

	@keyframes download-dock-launch {
		0%,
		100% {
			transform: translateY(0);
			animation-timing-function: cubic-bezier(0.333, 0.667, 0.667, 1);
		}

		50% {
			transform: translateY(-29.5px);
			animation-timing-function: cubic-bezier(0.333, 0, 0.667, 0.333);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.art-tip {
			transition: none;
		}

		.download-dock-icon-opaline {
			animation: none;
		}
	}

	.download-dock-icon {
		display: block;
		width: 91px;
		height: 91px;
		margin: 0 -2.5px;
		user-select: none;
		-webkit-user-drag: none;
	}

	.download-dock-tile {
		position: relative;
	}

	.download-dock-tile::before {
		content: "";
		position: absolute;
		inset: 9.5px;
		border-radius: 17px;
		background: linear-gradient(
			180deg,
			oklch(from var(--tile) calc(l + 0.08) c h),
			var(--tile)
		);
		box-shadow:
			inset 0 0 0 0.5px oklch(1 0 0 / 0.25),
			0 1px 2px oklch(0 0 0 / 0.18);
	}

	.download-intro {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.download-hero h1 {
		max-width: 720px;
		margin: 0;
		color: var(--landing-ink);
		font-size: clamp(32px, 5svh, 44px);
		font-weight: 600;
		letter-spacing: -0.04em;
		line-height: 1.1;
		text-wrap: balance;
	}

	.download-status {
		max-width: 60ch;
		margin: clamp(12px, 2.8svh, 28px) 0 0;
		color: var(--landing-ink-secondary);
		font-size: 16px;
		line-height: 1.6;
		text-wrap: pretty;
	}

	.download-status a {
		color: var(--landing-ink);
		text-decoration: underline;
		text-decoration-color: color-mix(
			in oklab,
			var(--landing-ink) 30%,
			transparent
		);
		text-underline-offset: 3px;
	}

	.download-steps {
		--step-object-width: 212px;
		display: grid;
		width: min(100%, 980px);
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 28px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.download-step {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: clamp(8px, 1.4svh, 14px);
		text-align: center;
	}

	.download-step .step-caption {
		max-width: 27ch;
		margin: 0;
		color: var(--landing-ink-secondary);
		font-size: 15px;
		line-height: 1.6;
		text-align: center;
		text-wrap: balance;
	}

	.step-pebble {
		position: relative;
		z-index: 1;
		display: inline-grid;
		width: 22px;
		height: 22px;
		margin: -3px 7px 0 0;
		place-items: center;
		vertical-align: middle;
		filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.35));
	}

	.step-pebble svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.step-pebble-fill {
		fill: oklch(0.27 0.004 286);
	}

	.step-pebble-ring {
		fill: none;
		stroke: rgb(255 255 255 / 0.14);
		stroke-width: 2;
	}

	.step-pebble-number {
		position: relative;
		color: var(--landing-ink);
		font-size: 12px;
		font-variant-numeric: tabular-nums;
		font-weight: 600;
		line-height: 1;
	}

	.download-step strong {
		color: var(--landing-ink);
		font-weight: 500;
	}

	.step-art {
		position: relative;
		display: flex;
		width: 100%;
		height: 148px;
		align-items: center;
		justify-content: center;
	}

	.step-art .art-cursor {
		position: absolute;
		z-index: 3;
		display: block;
		pointer-events: none;
	}

	.step-art .art-cursor-arrow {
		width: 28px;
		height: 40px;
	}

	.step-art .art-cursor-hand {
		width: 32px;
		height: 32px;
	}

	.step-art-downloads {
		align-items: flex-end;
	}

	.art-dock {
		display: flex;
		width: var(--step-object-width);
		align-items: flex-end;
		justify-content: center;
		gap: 10px;
		margin-bottom: 18px;
		padding: 7px 12px;
		border-radius: 20px;
		background: linear-gradient(
			180deg,
			rgb(255 255 255 / 0.16),
			rgb(255 255 255 / 0.07)
		);
		-webkit-backdrop-filter: blur(18px) saturate(1.6);
		backdrop-filter: blur(18px) saturate(1.6);
		box-shadow:
			inset 0 0 0 1px rgb(255 255 255 / 0.12),
			inset 0 1px 0 rgb(255 255 255 / 0.2),
			0 14px 30px -12px rgb(0 0 0 / 0.55);
	}

	@supports (corner-shape: squircle) {
		.art-dock {
			border-radius: 34px;
			corner-shape: squircle;
		}
	}

	.art-dock img {
		display: block;
		width: 52px;
		height: 52px;
	}

	.art-dock > img:first-child {
		width: 48px;
		height: 48px;
		margin: 2px;
	}

	.art-dock-divider {
		align-self: stretch;
		width: 1px;
		margin: 4px 0;
		background: rgb(255 255 255 / 0.22);
	}

	.art-dock-slot {
		position: relative;
		display: flex;
	}

	.art-file {
		position: relative;
		display: flex;
	}

	.art-progress {
		position: absolute;
		right: 6px;
		bottom: 6px;
		left: 6px;
		height: 5px;
		overflow: hidden;
		border-radius: 2.5px;
		background: rgb(28 28 30 / 0.88);
		box-shadow:
			inset 0 0 0 0.5px rgb(255 255 255 / 0.22),
			0 1px 3px rgb(0 0 0 / 0.5);
		opacity: 0;
	}

	.art-progress-fill {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: linear-gradient(180deg, #a9a9ad, #8c8c91);
		clip-path: inset(0 100% 0 0 round 2.5px);
	}

	.download-page[data-downloading] .art-progress {
		animation: art-progress-life 7.4s linear both;
	}

	.download-page[data-downloading] .art-progress-fill {
		animation: art-progress-fill 7.1s linear 0.05s both;
	}

	@keyframes art-progress-life {
		0% {
			opacity: 0;
		}

		3%,
		96% {
			opacity: 1;
		}

		100% {
			opacity: 0;
		}
	}

