---
import CompanyStrip from "../components/CompanyStrip.astro";
import { InstantV2DemoExperience } from "../components/InstantV2DemoExperience";
import InstantV2Nav from "../components/InstantV2Nav.astro";
import InstantV2ProductWindow from "../components/InstantV2ProductWindow.astro";
import { InstallCommandButton } from "../components/install-command-button";
import Layout from "../layouts/Layout.astro";

// This is the canonical public landing page. Prior designs live in /design-archive.

// The star count is read at build time, so visitors whose browser can't reach
// GitHub's API (60 unauthenticated requests an hour per IP) still see a
// current number. The script below refreshes it in the browser.
const GITHUB_REPOSITORY = "opalinehq/cli";
const GITHUB_STARS_FALLBACK = 305;
async function readGithubStars() {
	try {
		const token = process.env.GITHUB_TOKEN;
		const response = await fetch(
			`https://api.github.com/repos/${GITHUB_REPOSITORY}`,
			{
				headers: token ? { authorization: `Bearer ${token}` } : {},
				signal: AbortSignal.timeout(5_000),
			},
		);
		if (!response.ok) return GITHUB_STARS_FALLBACK;
		const payload: { stargazers_count?: unknown } = await response.json();
		return typeof payload.stargazers_count === "number" &&
			Number.isFinite(payload.stargazers_count)
			? Math.round(payload.stargazers_count)
			: GITHUB_STARS_FALLBACK;
	} catch {
		return GITHUB_STARS_FALLBACK;
	}
}
const githubStars = (await readGithubStars()).toLocaleString("en-US");
---

<Layout
	title="Team-wide, message-level analytics for coding agents › Opaline"
	description="Opaline tracks token cost, time, and skill usage for every single message across your team’s sessions."
	canonical="/"
>
	<InstantV2DemoExperience client:load />
	<div class="instant-v2-scroll" data-instant-v2-scroll>
	<div class="instant-v2-scroll-content" data-instant-v2-scroll-content>
	<InstantV2Nav />
	<main class="instant-v2">
		<section
			class="instant-v2-intro"
			aria-labelledby="instant-v2-heading"
			data-instant-v2-demo-background
			data-instant-v2-intro
		>
			<div
				class="instant-v2-container instant-v2-grid"
				data-instant-v2-hero-content
			>
				<h1 id="instant-v2-heading">
					Pull back the curtain on<br /><span
						class="instant-v2-title-last-line"
						>your coding sessions.</span
					>
				</h1>

				<div class="instant-v2-support">
					<p>
						Analytics for your team's Claude Code<span
							class="instant-v2-support-mobile-break"
							><br /></span
						><span class="instant-v2-support-agent-line"
							> and Codex sessions.{" "}</span
						><span class="instant-v2-support-learning">
							Turn teammate struggle into learning.</span
						>
					</p>

					<div class="instant-v2-actions">
						<div class="instant-v2-command-group">
							<a
								class="instant-v2-open-source"
								data-instant-v2-github
								data-github-repo={GITHUB_REPOSITORY}
								href={`https://github.com/${GITHUB_REPOSITORY}`}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`Opaline CLI on GitHub — ${githubStars} stars`}
							>
								<span
									class="instant-v2-open-source-github"
								>
									<svg
										viewBox="0 0 24 24"
										fill="currentColor"
										aria-hidden="true"
									>
										<path
											fill-rule="evenodd"
											clip-rule="evenodd"
											d="M12 1.5a10.5 10.5 0 0 0-3.32 20.46c.53.1.72-.23.72-.51v-1.84c-2.94.64-3.56-1.25-3.56-1.25-.48-1.22-1.17-1.55-1.17-1.55-.96-.65.07-.64.07-.64 1.06.08 1.62 1.09 1.62 1.09.94 1.61 2.47 1.15 3.08.88.09-.68.37-1.15.67-1.42-2.35-.27-4.82-1.17-4.82-5.19 0-1.15.41-2.08 1.08-2.82-.11-.27-.47-1.34.1-2.78 0 0 .88-.28 2.89 1.08A10.1 10.1 0 0 1 12 6.65c.89 0 1.79.12 2.63.35 2-1.36 2.89-1.08 2.89-1.08.57 1.44.21 2.51.1 2.78.67.74 1.08 1.67 1.08 2.82 0 4.03-2.48 4.92-4.83 5.18.38.33.72.97.72 1.96v2.79c0 .28.19.62.73.51A10.5 10.5 0 0 0 12 1.5Z"
										></path>
									</svg>
									<span data-instant-v2-github-count>{githubStars}</span>
								</span>
								<span class="instant-v2-open-source-label">MIT OSS</span>
							</a>
							<InstallCommandButton
								command="npx opaline@latest"
								data-marketing-install-source="hero"
								data-install-command="npx opaline@latest"
								aria-label="copy install command: npx opaline@latest"
								title="copy install command"
							/>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section
			class="instant-v2-showcase instant-v2-container"
			id="product"
			aria-label="Opaline product"
		>
			<InstantV2ProductWindow />
			<CompanyStrip />
		</section>
	</main>
	</div>
	</div>
</Layout>

<style>
	.instant-v2-scroll,
	.instant-v2-scroll-content {
		display: contents;
	}

	:global(html[data-instant-v2-safari-scroll]),
	:global(html[data-instant-v2-safari-scroll] body) {
		height: 100%;
		overflow: hidden;
	}

	:global(html[data-instant-v2-safari-scroll]) .instant-v2-scroll {
		display: block;
		height: 100dvh;
		overflow: auto;
		overscroll-behavior: none;
	}

	:global(html[data-instant-v2-safari-scroll]) .instant-v2-scroll-content {
		display: block;
		min-height: 100%;
	}

	:global(html[data-instant-v2-safari-scroll]:is([data-instant-v2-demo], [data-instant-v2-demo-exiting]))
		.instant-v2-scroll {
		overflow: hidden;
	}

	:global(html[data-instant-v2-safari-scroll]:is([data-instant-v2-demo], [data-instant-v2-demo-exiting]))
		.instant-v2-scroll-content {
		/* Preserve the scroll range while the product leaves normal flow. */
		min-height: var(--instant-v2-scroll-content-height, 100%);
	}

	:global(html),
	:global(body) {
		overscroll-behavior: none;
	}

	:global(html) {
		--instant-v2-hero-recede-progress: 0;
		--instant-v2-page-bg: var(--landing-page);
		background: var(--landing-page);
	}

	:global(body) {
		background: var(--instant-v2-page-bg, var(--landing-page));
		transition: background-color
			var(--instant-v2-page-bg-duration, 420ms)
			var(
				--instant-v2-page-bg-easing,
				cubic-bezier(0.22, 1, 0.36, 1)
			);
	}


	:global(html[data-instant-v2-demo-exiting]) {
		--instant-v2-page-bg: var(--landing-page);
		--instant-v2-page-bg-duration: var(
			--instant-v2-demo-exit-duration,
			1150ms
		);
		--instant-v2-page-bg-easing: linear;
	}

	.instant-v2 {
		--instant-v2-page-width: 1920px;
		min-height: 100svh;
		overflow-x: clip;
		background: transparent;
		color: var(--color-ink);
	}

	:global(html:not([data-instant-v2-demo]):not([data-instant-v2-demo-exiting])) .instant-v2 {
		/* Contain the padded blur without adding a scroll container. */
		overflow: clip;
	}

	.instant-v2-container {
		width: min(calc(100% - clamp(48px, 6.75vw, 136px)), var(--instant-v2-page-width));
		margin-inline: auto;
	}

	@supports (width: round(nearest, 1px, 1px)) {
		.instant-v2-container {
			width: min(
				calc(100% - round(nearest, clamp(48px, 6.75vw, 136px), 2px)),
				var(--instant-v2-page-width)
			);
		}
	}

	.instant-v2-intro {
		position: sticky;
		z-index: 0;
		top: 42px;
		padding-block: max(134px, calc(clamp(176px, 26svh, 296px) - 42px))
			clamp(152px, 18.5svh, 210px);
	}

	.instant-v2-grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		align-items: start;
		column-gap: 24px;
		opacity: calc(1 - var(--instant-v2-hero-recede-progress));
		transform: translateZ(0) scale(
			calc(1 - var(--instant-v2-hero-recede-progress) * 0.1)
		);
		transform-origin: center;
		/* Prepare the fading text and buttons before the first scroll. */
		will-change: transform, opacity;
	}

	.instant-v2 h1 {
		grid-column: 1 / span 7;
		max-width: 820px;
		margin: 0;
		color: var(--landing-ink);
		font-family: "Inter Variable", Inter, sans-serif;
		font-feature-settings: "ss03";
		font-size: 56px;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1;
		text-wrap: balance;
		transform: translateX(-4px);
	}

	.instant-v2-title-last-line {
		white-space: nowrap;
	}

	.instant-v2-support-mobile-break {
		display: none;
	}

	.instant-v2-support {
		--instant-v2-copy-offset-y: 0px;
		--instant-v2-action-offset-y: 0px;
		grid-column: 8 / -1;
		justify-self: end;
		width: 100%;
		max-width: 480px;
		padding-top: 3px;
		text-align: right;
	}

	.instant-v2-support p {
		max-width: 42ch;
		margin: 0 0 0 auto;
		color: var(--landing-ink-secondary);
		font-family: "Inter Variable", Inter, sans-serif;
		font-feature-settings: "ss03";
		font-size: 15px;
		font-weight: 400;
		letter-spacing: normal;
		line-height: 24px;
		text-wrap: pretty;
		transform: translateY(var(--instant-v2-copy-offset-y));
	}

	.instant-v2-actions {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		/* Optical alignment: paragraph ink + gap + CTA matches the heading ink. */
		margin-top: 14px;
		transform: translateY(var(--instant-v2-action-offset-y));
	}

	.instant-v2-command-group {
		--instant-v2-command-height: 40px;
		display: inline-flex;
		height: var(--instant-v2-command-height);
		max-width: 100%;
		align-items: stretch;
		justify-content: flex-end;
		padding: 0;
		border-radius: 8px;
		background: var(--landing-fill);
		overflow: hidden;
	}

	.instant-v2-open-source {
		display: inline-flex;
		height: 100%;
		min-width: 0;
		align-items: center;
		gap: 4px;
		padding-inline: 14px;
		border: 0;
		border-radius: 8px 0 0 8px;
		background: transparent;
		color: var(--landing-ink);
		font-family: "Inter Variable", Inter, sans-serif;
		font-feature-settings: "ss03";
		font-size: 13px;
		font-weight: 500;
		letter-spacing: normal;
		line-height: 20px;
		overflow: hidden;
		text-decoration: none;
		white-space: nowrap;
	}

	.instant-v2-open-source-label {
		display: inline-flex;
		min-width: 0;
		align-items: center;
		color: var(--landing-ink-secondary);
	}

	.instant-v2-open-source-github {
		display: inline-flex;
		height: 100%;
		align-items: center;
		justify-content: center;
		gap: 6px;
		color: var(--landing-ink);
		font-variant-numeric: tabular-nums;
	}

	.instant-v2-open-source-github svg {
		display: block;
		width: 18px;
		height: 18px;
		flex: 0 0 18px;
	}

	.instant-v2-open-source:focus-visible {
		outline: 2px solid var(--landing-focus);
		outline-offset: -2px;
	}

	.instant-v2-showcase {
		--instant-v2-showcase-gutter: clamp(6px, 0.84375vw, 17px);
		--instant-v2-company-strip-height: 52px;
		--instant-v2-company-strip-offset-top: var(
			--instant-v2-showcase-gutter
		);
		position: relative;
		z-index: 1;
		width: calc(100% - clamp(12px, 1.6875vw, 34px));
		min-height: calc(100svh - 42px + 1px);
		max-width: none;
	}

	.instant-v2-showcase :global(.company-strip) {
		position: relative;
		z-index: 51;
	}

	@media (max-width: 899px) {
		.instant-v2-container {
			width: min(calc(100% - 40px), 720px);
		}

		.instant-v2-showcase {
			--instant-v2-showcase-gutter: max(5px, calc(12.5vw - 90px));
			width: calc(100% - max(10px, calc(25% - 180px)));
			max-width: none;
		}

		.instant-v2-intro {
			padding-block: calc(clamp(64px, 11svh, 104px) + 22px) 88px;
		}

		.instant-v2-grid {
			grid-template-columns: 1fr;
			row-gap: 42px;
		}

		.instant-v2 h1,
		.instant-v2-support {
			grid-column: 1;
		}

		.instant-v2 h1 {
			max-width: 720px;
			font-size: 56px;
			transform: none;
		}

		.instant-v2-support {
			justify-self: start;
			max-width: 520px;
			padding-top: 0;
			text-align: left;
		}

		.instant-v2-support p {
			margin-left: 0;
		}

		.instant-v2-actions {
			justify-content: flex-start;
		}
	}

	@media (max-width: 540px) {
		:global(html) {
			--instant-v2-mobile-footer-height: calc(
				84px + env(safe-area-inset-bottom, 0px)
			);
		}

		.instant-v2-container {
			width: calc(100% - 32px);
		}

		.instant-v2-showcase {
			--instant-v2-showcase-gutter: 4px;
			--instant-v2-company-strip-height: var(--instant-v2-mobile-footer-height);
			width: calc(100% - 8px);
			min-height: calc(100dvh - 42px);
		}

		.instant-v2-showcase :global(.company-strip) {
			/* Reserve the end of the stage so the footer never crosses the preview. */
			position: absolute;
			z-index: 49;
			inset: auto calc(-1 * var(--instant-v2-showcase-gutter)) 0;
			height: var(--instant-v2-mobile-footer-height);
			min-height: 0;
			margin: 0;
			padding: 0 max(10px, env(safe-area-inset-right, 0px))
				env(safe-area-inset-bottom, 0px) max(10px, env(safe-area-inset-left, 0px));
			background: var(--instant-v2-page-bg, var(--landing-page));
		}

		.instant-v2-showcase :global(.company-strip-inner) {
			width: 100%;
			min-height: 84px;
			gap: 0;
			padding-block: 12px 4px;
		}

		/* Tall tap targets whose padding is the spacing, so every label sits
		 * the same 16px apart and the row stays centred. */
		.instant-v2-showcase :global(.company-strip-links) {
			gap: 0;
		}

		.instant-v2-showcase :global(.company-strip-links a) {
			display: inline-flex;
			min-height: 44px;
			align-items: center;
			justify-content: center;
			padding-inline: 8px;
			-webkit-tap-highlight-color: transparent;
		}

		.instant-v2-intro {
			padding-block: 86px 72px;
		}

		.instant-v2-grid {
			justify-items: center;
			row-gap: 12px;
		}

		.instant-v2 h1 {
			max-width: none;
			font-size: clamp(27px, 8.5vw, 36px);
			letter-spacing: -0.01em;
			line-height: 1;
			text-align: center;
		}

		.instant-v2-support {
			justify-self: center;
			text-align: center;
		}

		.instant-v2-support p {
			max-width: 36ch;
			margin-inline: auto;
			font-size: 16px;
			line-height: 1.55;
		}

		.instant-v2-support-mobile-break {
			display: inline;
		}

		.instant-v2-support-agent-line {
			white-space: nowrap;
		}

		.instant-v2-support-learning {
			display: none;
		}

		.instant-v2-actions {
			justify-content: center;
			gap: 10px;
			margin-top: 28px;
		}

		.instant-v2-command-group {
			--instant-v2-command-height: 44px;
		}
	}

	/* Too narrow for one row of footer links: room for a second row, with
	 * rows as far apart as the links (16px between labels both ways). */
	@media (max-width: 379px) {
		:global(html) {
			--instant-v2-mobile-footer-height: calc(
				112px + env(safe-area-inset-bottom, 0px)
			);
		}

		.instant-v2-showcase :global(.company-strip-inner) {
			gap: 8px;
		}

		.instant-v2-showcase :global(.company-strip-links) {
			row-gap: 0;
		}

		.instant-v2-showcase :global(.company-strip-links a) {
			min-height: 32px;
		}
	}

	@media (max-width: 400px) {
		.instant-v2-open-source {
			padding-inline: 12px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(html),
		:global(body),
		.instant-v2 {
			transition-duration: 0.01ms;
		}

		.instant-v2-grid {
			opacity: 1;
			transform: none;
		}
	}
</style>

<script>
	import { initializeInstantV2LandingMotion } from "../scripts/instant-v2-landing-motion";
	initializeInstantV2LandingMotion();

	const githubLink = document.querySelector<HTMLAnchorElement>(
		"[data-instant-v2-github][data-github-repo]",
	);
	const githubCount = githubLink?.querySelector<HTMLElement>(
		"[data-instant-v2-github-count]",
	);

	const hydrateGithubStars = async () => {
		const repository = githubLink?.dataset.githubRepo;
		if (!githubLink || !githubCount || !repository) return;

		try {
			const response = await fetch(`https://api.github.com/repos/${repository}`, {
				cache: "no-cache",
			});
			if (!response.ok) return;

			const payload: unknown = await response.json();
			if (
				typeof payload !== "object" ||
				payload === null ||
				!("stargazers_count" in payload) ||
				typeof payload.stargazers_count !== "number" ||
				!Number.isFinite(payload.stargazers_count)
			) {
				return;
			}

			const formattedCount = Math.round(payload.stargazers_count).toLocaleString(
				"en-US",
			);
			githubCount.textContent = formattedCount;
			githubLink.setAttribute(
				"aria-label",
				`Opaline CLI on GitHub — ${formattedCount} stars`,
			);
		} catch {
			// The rendered fallback keeps this control useful if GitHub is unavailable.
		}
	};

	void hydrateGithubStars();
</script>
