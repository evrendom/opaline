---
// BETA LAUNCH HOLD: Keep this implementation ready for later, but do not ship
// a public pricing route until payment management can be supported at launch.
import InstantV2Nav from "../components/InstantV2Nav.astro";
import PricingCheck from "../components/PricingCheck.astro";
import Layout from "../layouts/Layout.astro";

const plans = [
	{
		id: "free",
		name: "Free",
		price: "$0",
		billing: "Free for everyone",
		features: [
			"Unlimited members",
			"2 projects",
			"250 sessions per month",
			"Session timelines",
			"Open-source CLI",
		],
		variant: "secondary",
	},
	{
		id: "basic",
		name: "Basic",
		yearlyPrice: "$12",
		monthlyPrice: "$15",
		features: [
			"All Free features +",
			"5 projects",
			"Unlimited sessions",
			"90-day retention",
			"Admin roles",
		],
		variant: "secondary",
	},
	{
		id: "business",
		name: "Business",
		yearlyPrice: "$18",
		monthlyPrice: "$22",
		features: [
			"All Basic features +",
			"Unlimited projects",
			"Private projects and guests",
			"Root-cause analysis",
			"Session replay",
			"Cost intelligence",
			"Team insights",
			"AI evaluations",
			"Slack and GitHub integrations",
		],
		variant: "invert",
	},
] as const;
---

<Layout
	title="Pricing — Opaline"
	description="Simple pricing for understanding every agent session, from first trace to production scale."
>
	<InstantV2Nav
		active="pricing"
		productHref="/home"
		enableDemo={false}
	/>

	<main class="pricing-page">
		<div class="pricing-layout">
			<h1 class="visually-hidden">Pricing</h1>
			<div class="pricing-plans">
				{
					plans.map((plan) => (
						<section id={plan.id} class="pricing-card">
							<hgroup>
								<h2>{plan.name}</h2>
								<div class="pricing-title-gap" aria-hidden="true" />
								<div class="pricing-price">
									{"price" in plan ? (
										<span>{plan.price}</span>
									) : (
										<>
											<span
												class="pricing-price-value"
												data-yearly-price={plan.yearlyPrice}
												data-monthly-price={plan.monthlyPrice}
											>
												{plan.yearlyPrice}
											</span>
											<span class="pricing-price-suffix"> per user/month</span>
										</>
									)}
								</div>
							</hgroup>

							<div class="pricing-billing">
								{"billing" in plan ? (
									<span class="pricing-billing-label">{plan.billing}</span>
								) : (
									<div class="pricing-billing-control">
										<label class="pricing-switch" for={`${plan.id}-billing`}>
											<input
												id={`${plan.id}-billing`}
												type="checkbox"
												checked
												data-pricing-billing-toggle
												aria-label={`Use yearly billing for ${plan.name}`}
											/>
											<span class="pricing-switch-thumb" aria-hidden="true" />
										</label>
										<label
											class="pricing-billing-label"
											for={`${plan.id}-billing`}
											data-pricing-billing-label
										>
											Billed yearly
										</label>
									</div>
								)}
							</div>

							<ul class="pricing-features">
								{plan.features.map((feature) => (
									<li>
										<PricingCheck />
										<span>{feature}</span>
									</li>
								))}
							</ul>

							<div class="pricing-actions">
								<a
									class:list={[
										"pricing-button",
										plan.variant === "invert"
											? "pricing-button-invert"
											: "pricing-button-secondary",
									]}
									href="/home#product"
								>
									Get started
								</a>
								{plan.id === "business" && (
									<a
										class="pricing-button pricing-button-secondary"
										href="mailto:sales@opalinehq.com"
									>
										Contact sales
									</a>
								)}
							</div>
						</section>
					))
				}
			</div>
		</div>
	</main>
</Layout>

<style>
	:global(html),
	:global(body) {
		background: #fff;
		overscroll-behavior: none;
	}

	.pricing-page {
		--pricing-outer-padding: 46px;
		--pricing-card-inset: 32px;
		min-height: calc(100svh - 42px);
		padding-bottom: 132px;
		background: #fff;
		color: #282a30;
	}

	.pricing-layout {
		width: 100%;
		max-width: calc(1344px + var(--pricing-outer-padding) * 2);
		margin-inline: auto;
		padding: 132px var(--pricing-outer-padding) 0;
	}

	.pricing-plans {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.pricing-card {
		display: flex;
		min-width: 0;
		min-height: 534px;
		flex-direction: column;
		padding-inline: var(--pricing-card-inset);
	}

	.pricing-card:not(:first-child) {
		border-left: 1px solid rgba(0, 0, 0, 0.05);
	}

	.pricing-card h2 {
		margin: 0;
		color: #282a30;
		font-size: 24px;
		font-weight: 590;
		letter-spacing: -0.012em;
		line-height: 1.33;
	}

	.pricing-title-gap {
		height: 8px;
	}

	.pricing-price {
		display: flex;
		height: 24px;
		align-items: center;
		color: #3c4149;
		font-size: 17px;
		font-weight: 510;
		letter-spacing: 0;
		line-height: 1.6;
	}

	.pricing-price-value {
		font-variant-numeric: tabular-nums;
	}

	.pricing-price-suffix {
		margin-left: 4px;
		color: #6f6e77;
		font-weight: 400;
	}

	.pricing-billing {
		display: flex;
		height: 60px;
		align-items: center;
		margin-top: 16px;
		border-block: 1px solid rgba(0, 0, 0, 0.05);
	}

	.pricing-billing-control {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.pricing-billing-label {
		color: #6f6e77;
		font-size: 14px;
		font-weight: 400;
		letter-spacing: -0.013em;
		line-height: 1.5;
	}

	.pricing-switch {
		--switch-height: 20px;
		--switch-width: 32px;
		--switch-thumb-size: 14px;
		position: relative;
		display: flex;
		width: var(--switch-width);
		height: var(--switch-height);
		align-items: center;
		padding: 3px;
		border-radius: 999px;
		background: #b5b5b8;
		cursor: pointer;
		transition: background-color 150ms ease;
	}

	.pricing-switch:has(input:checked) {
		background: #17181b;
	}

	.pricing-switch:has(input:focus-visible) {
		outline: 2px solid var(--color-focus);
		outline-offset: 3px;
	}

	.pricing-switch input {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
	}

	.pricing-switch-thumb {
		display: block;
		width: var(--switch-thumb-size);
		height: var(--switch-thumb-size);
		border-radius: 999px;
		background: #fff;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.18);
		transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.pricing-switch input:checked + .pricing-switch-thumb {
		transform: translateX(12px);
	}

	.pricing-features {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 0;
		margin: 24px 0 0;
		list-style: none;
	}

	.pricing-features li {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 0;
		color: #3c4149;
		font-size: 13px;
		font-weight: 400;
		letter-spacing: -0.01em;
		line-height: 1.5;
	}

	.pricing-features :global(.pricing-check) {
		flex: 0 0 auto;
		fill: #6f6e77;
	}

	.pricing-actions {
		display: flex;
		width: 100%;
		gap: 8px;
		padding-top: 44px;
		margin-top: auto;
	}

	.pricing-button {
		display: inline-flex;
		min-width: 0;
		height: 40px;
		flex: 1 1 0;
		align-items: center;
		justify-content: center;
		padding-inline: 14px;
		border-radius: 999px;
		font-size: 13px;
		font-weight: 510;
		line-height: 40px;
		white-space: nowrap;
		transition:
			background-color 160ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
			box-shadow 160ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
			transform 160ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	.pricing-button-secondary {
		background: #fff;
		box-shadow:
			0 0 0 1px rgba(0, 0, 0, 0.08),
			0 1px 2px rgba(0, 0, 0, 0.06);
		color: #282a30;
	}

	.pricing-button-invert {
		border: 1px solid #282a30;
		background: #282a30;
		color: #fff;
	}

	@media (any-hover: hover) {
		.pricing-button-secondary:hover {
			background: #f7f7f8;
		}

		.pricing-button-invert:hover {
			background: #1f2024;
		}
	}

	.pricing-button:active {
		transform: scale(0.97);
	}

	@media (max-width: 1280px) {
		.pricing-page {
			--pricing-outer-padding: 10px;
		}
	}

	@media (max-width: 1024px) {
		.pricing-page {
			--pricing-outer-padding: 28px;
			--pricing-card-inset: 8px;
		}

		.pricing-layout {
			padding-top: 92px;
		}

		.pricing-plans {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			row-gap: 64px;
		}

		.pricing-card {
			min-height: 0;
		}

		.pricing-card:not(:first-child) {
			border-left: 0;
		}
	}

	@media (max-width: 768px) {
		.pricing-plans {
			grid-template-columns: minmax(0, 1fr);
		}

		.pricing-actions {
			margin-top: 0;
		}
	}

	@media (max-width: 640px) {
		.pricing-page {
			--pricing-outer-padding: 16px;
			padding-bottom: 88px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pricing-switch,
		.pricing-switch-thumb,
		.pricing-button {
			transition-duration: 0.01ms;
		}
	}
</style>

<script>
	const billingToggles = Array.from(
		document.querySelectorAll<HTMLInputElement>(
			"[data-pricing-billing-toggle]",
		),
	);
	const billingLabels = Array.from(
		document.querySelectorAll<HTMLElement>("[data-pricing-billing-label]"),
	);
	const prices = Array.from(
		document.querySelectorAll<HTMLElement>("[data-yearly-price]"),
	);

	const setBillingCycle = (yearly: boolean) => {
		for (const toggle of billingToggles) toggle.checked = yearly;
		for (const label of billingLabels) {
			label.textContent = yearly ? "Billed yearly" : "Billed monthly";
		}
		for (const price of prices) {
			price.textContent = yearly
				? price.dataset.yearlyPrice ?? ""
				: price.dataset.monthlyPrice ?? "";
		}
	};

	for (const toggle of billingToggles) {
		toggle.addEventListener("change", () => setBillingCycle(toggle.checked));
	}
</script>
