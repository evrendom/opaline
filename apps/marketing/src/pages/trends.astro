---
import { TrendsExplorer } from "../components/trends/TrendsExplorer";
import TrendsPage from "../components/trends/TrendsPage.astro";
import {
	liveTrendsSources,
	loadTrendsSnapshot,
} from "../trends/load-trends-snapshot";

const snapshot = loadTrendsSnapshot();
const live = liveTrendsSources();
---

<TrendsPage snapshot={snapshot}>
	<TrendsExplorer client:load snapshot={snapshot} live={live} />
</TrendsPage>
