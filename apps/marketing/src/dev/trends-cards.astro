---
import TrendsPage from "../components/trends/TrendsPage.astro";
import {
	liveTrendsSources,
	loadTrendsSnapshot,
} from "../trends/load-trends-snapshot";
import { TrendsCardPlayground } from "./TrendsCardPlayground";

/* The PNG card playground, served by `astro dev` only (astro.config.mjs). */
const snapshot = loadTrendsSnapshot();
const live = liveTrendsSources();
---

<TrendsPage snapshot={snapshot} noindex>
	<TrendsCardPlayground client:load snapshot={snapshot} live={live} />
</TrendsPage>
