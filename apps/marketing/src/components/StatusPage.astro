---
import Layout from "../layouts/Layout.astro";

interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;
---

<Layout
	title={`${title} | Opaline`}
	description={description}
	noindex
>
	<main class="not-found" aria-labelledby="not-found-title">
		<div class="not-found-content">
			<img
				class="not-found-icon"
				data-theme-asset="light"
				src="/opaline-icon.svg"
				alt=""
				width="64"
				height="64"
			/>
			<img
				class="not-found-icon"
				data-theme-asset="dark"
				src="/opaline-icon-dark.svg"
				alt=""
				width="64"
				height="64"
			/>
			<div class="not-found-copy">
				<h1 id="not-found-title">{title}</h1>
				<p>{description}</p>
			</div>
			<a class="not-found-home" href="/">Go back to homepage</a>
		</div>
	</main>
</Layout>

<style>
	:global(html),
	:global(body) {
		height: 100%;
		overflow: hidden;
		overscroll-behavior: none;
	}

	.not-found {
		display: grid;
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100svh;
		overflow: hidden;
		overscroll-behavior: none;
		place-items: center;
		padding: 64px 24px;
		background: var(--color-surface);
	}

	.not-found-content {
		display: flex;
		width: min(100%, 360px);
		align-items: center;
		flex-direction: column;
		text-align: center;
	}

	.not-found-icon {
		width: 64px;
		height: 64px;
		margin-bottom: 40px;
		animation: not-found-icon-drift 3.6s ease-in-out infinite;
	}

	/* Both icons render; the theme picks one, so the markup never changes. */
	.not-found-icon[data-theme-asset="dark"],
	:global(html.dark) .not-found-icon[data-theme-asset="light"] {
		display: none;
	}

	:global(html.dark) .not-found-icon[data-theme-asset="dark"] {
		display: block;
	}

	.not-found-copy {
		display: grid;
		gap: 8px;
	}

	h1,
	p {
		margin: 0;
	}

	h1 {
		color: var(--color-ink-strong);
		font-size: 20px;
		font-weight: 550;
		letter-spacing: -0.025em;
		line-height: 1.3;
	}

	p {
		color: var(--color-ink-muted);
		font-size: 16px;
		line-height: 1.5;
	}

	.not-found-home {
		display: inline-flex;
		min-height: 44px;
		align-items: center;
		justify-content: center;
		padding: 0 18px;
		margin-top: 32px;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-small);
		background: var(--color-surface);
		box-shadow: 0 1px 2px rgba(23, 24, 27, 0.06);
		color: var(--color-ink);
		font-size: 14px;
		font-weight: 500;
		line-height: 20px;
		transition:
			border-color 150ms ease,
			background-color 150ms ease,
			transform 150ms ease;
	}

	.not-found-home:hover {
		border-color: rgb(var(--landing-ink-rgb) / 0.18);
		background: var(--color-surface-subtle);
	}

	.not-found-home:active {
		transform: translateY(1px);
	}

	@keyframes not-found-icon-drift {
		0%,
		100% {
			transform: rotate(-2deg) translateY(0);
		}

		50% {
			transform: rotate(2deg) translateY(-3px);
		}
	}

	@media (min-width: 768px) {
		.not-found {
			padding-block: 96px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.not-found-icon {
			animation: none;
		}
	}
</style>
