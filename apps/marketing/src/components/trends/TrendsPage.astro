---
import Layout from "../../layouts/Layout.astro";
import type { TrendsSnapshot } from "../../trends/trends-snapshot";
import InstantV2Nav from "../InstantV2Nav.astro";
import { TRENDS_NAV_TABS } from "./TrendsExplorer";

/* The Trends page around its explorer, which comes in the slot: the
 * trends page's, or the card playground's (dev/trends-cards). */
interface Props {
	snapshot: TrendsSnapshot;
	/** For pages that must never be indexed, whatever the sources. */
	noindex?: boolean;
}

const { snapshot, noindex = false } = Astro.props;
---

<Layout
	title="Coding agent trends: benchmarks, agent runs, and dev usage › Opaline"
	description="Opaline compares model intelligence, cost, and time across reasoning efforts, alongside run time, tool calls, and usage from real coding agent sessions."
	canonical="/trends"
	dateModified={snapshot.publishedAt}
	noindex={noindex || snapshot.sources.benchmarks.kind === "preview" || snapshot.sources.usage.kind === "preview"}
	darkThemeColor="#141417"
>
	<div class="trends-site-nav">
		<InstantV2Nav
			active="trends"
			install={false}
			pricing={false}
			wordmark="trends"
		>
			{/* After the Opaline Trends wordmark: a chevron, then the
			    charts' tabs (a menu of them on a phone). The explorer
			    renders them into the target once hydrated; until then a
			    static copy stands in their place, so they are there from
			    the first paint. */}
			<span class="trends-nav-trail" slot="trail">
				<svg class="trends-nav-arrow" viewBox="0 0 16 16" aria-hidden="true">
					<path d="M6 3.5 10.5 8 6 12.5" />
				</svg>
				<span class="trends-nav-trail-static" aria-hidden="true">
					<span class="trends-tabs">
						{TRENDS_NAV_TABS.map(({ route, tab }, index) => (
							<span
								class="trends-tab"
								data-route={route}
								data-selected={index === 0 ? "" : undefined}
							>
								{tab}
							</span>
						))}
					</span>
					<span class="trends-crumb">
						<span class="trends-crumb-button">
							<span data-trends-crumb-label>{TRENDS_NAV_TABS[0]?.tab}</span>
							<svg viewBox="0 0 16 16">
								<path d="M4.5 6.5 8 10l3.5-3.5" />
							</svg>
						</span>
					</span>
				</span>
				{/* Before the first paint: the tab the link opens on. */}
				<script is:inline>
					(() => {
						const copy = document.currentScript.previousElementSibling;
						const route = location.hash.slice(1).split(/[/?]/)[0];
						const tabs = [...copy.querySelectorAll("[data-route]")];
						const current = tabs.find((tab) => tab.dataset.route === route);
						if (!current) return;
						for (const tab of tabs) delete tab.dataset.selected;
						current.dataset.selected = "";
						copy.querySelector("[data-trends-crumb-label]").textContent =
							current.textContent;
					})();
				</script>
				<span class="trends-nav-trail-target" data-trends-nav-trail></span>
			</span>
		</InstantV2Nav>
	</div>
	<h1 class="visually-hidden">Opaline Trends</h1>
	<slot />
</Layout>

<style>
	/* The app shell owns scrolling; no rubber-band or scroll chaining. */
	:global(html),
	:global(body) {
		overscroll-behavior: none;
	}

	/* The landing page's navigation over the app, which takes the rest of
	 * the viewport; on the app's surface, so it follows its dark mode. */
	:global(body) {
		--trends-site-nav: 42px;
	}

	/* No box of its own, so the navigation stays sticky on the page. */
	.trends-site-nav {
		display: contents;
	}

	.trends-site-nav :global(.instant-v2-nav) {
		background: var(--color-surface);
	}

	/* The wordmark leads the breadcrumb, so the chevron follows it as
	 * closely as the tabs follow the chevron. */
	.trends-site-nav :global(.instant-v2-nav-inner) {
		gap: 8px;
	}

	@media (prefers-color-scheme: dark) {
		.trends-site-nav :global(.instant-v2-nav) {
			--instant-v2-nav-ink: var(--color-ink-strong);
			--instant-v2-nav-ink-muted: var(--color-ink-muted);
			--instant-v2-nav-button: #2a2a2f;
			--instant-v2-nav-button-pressed: #222226;
			--instant-v2-nav-button-ink: var(--color-ink-strong);
			--instant-v2-nav-button-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.06);
			--instant-v2-nav-glass: rgb(42 42 47 / 0.36);
			--instant-v2-nav-glass-edge: inset 0 0 0 1px rgb(255 255 255 / 0.06);
		}
	}
</style>
