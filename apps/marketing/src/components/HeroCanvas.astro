---
interface Props {
	opacity?: number;
}
const { opacity } = Astro.props;
---

<div
	class="hero-canvas-stage"
	data-hero-canvas-stage
	data-hero-canvas-opacity={opacity}
	aria-hidden="true"
>
	<div class="hero-canvas-viewport">
		<canvas class="hero-canvas" data-hero-canvas></canvas>
	</div>
</div>

<script>
	import { initializeHeroCanvas } from "../scripts/hero-canvas";

	if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
		for (const canvas of document.querySelectorAll<HTMLCanvasElement>(
			"[data-hero-canvas]",
		)) {
			initializeHeroCanvas(
				canvas,
				canvas.closest<HTMLElement>(".instant-v2-hero-gradient-surface"),
			);
		}
	}
</script>

<style>
	.hero-canvas-stage {
		position: absolute;
		z-index: 0;
		inset: 0;
		pointer-events: none;
	}
	.hero-canvas-viewport,
	.hero-canvas {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
	}
	.hero-canvas {
		opacity: 0;
	}
	.hero-canvas-stage[data-canvas-ready] .hero-canvas {
		opacity: 1;
	}
</style>
