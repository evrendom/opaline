{
	"name": "@rudel/web",
	"private": true,
	"packageManager": "bun@1.3.9",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:demo": "vite --mode product-demo --config vite.local-demo.config.ts",
		"dev:onboarding": "vite --config vite.onboarding-dev.config.ts",
		"dev:email-lab": "vite --config vite.email-lab.config.ts --open /email-lab.html",
		"build": "vite build",
		"build:demo": "bun tools/build-demo.mjs",
		"build:widget": "bun tools/build-widget.mjs",
		"export:demo-seed": "bun --tsconfig-override tsconfig.app.json tools/export-demo-seed.ts",
		"check-types": "tsc -b",
		"check:design": "bun tools/design-escapes.ts",
		"test": "vitest run && bun tools/run-bun-tests.ts",
		"trace-tree:e2e:browsers": "playwright install chromium firefox webkit",
		"test:trace-tree:e2e": "playwright test --config=playwright.trace-tree.config.ts",
		"test:resource-budgets:chrome": "playwright test --config playwright.config.ts",
		"preview": "vite preview"
	},
	"dependencies": {
		"@legendapp/list": "3.7.1",
		"@base-ui/react": "^1.3.0",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource/geist-mono": "^5.2.7",
		"@fontsource/nunito": "^5.2.7",
		"@number-flow/react": "0.6.2",
		"@orpc/client": "latest",
		"@orpc/contract": "latest",
		"@orpc/tanstack-query": "latest",
		"@rudel/api-routes": "workspace:*",
		"@rudel/language-signals": "workspace:*",
		"@tabler/icons-react": "3.48.0",
		"@tanstack/react-query": "^5.80.0",
		"@tanstack/react-virtual": "3.14.9",
		"better-auth": "1.6.34",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"framer-motion": "13.2.0",
		"glimm": "0.1.4",
		"motion": "^12.38.0",
		"next-themes": "^0.4.6",
		"posthog-js": "1.407.5",
		"radix-ui": "^1.4.3",
		"react": "^19.2.0",
		"react-day-picker": "^9.14.0",
		"react-dom": "^19.2.0",
		"react-markdown": "^10.1.0",
		"react-router-dom": "^7.13.0",
		"react-syntax-highlighter": "^16.1.0",
		"recharts": "^3.7.0",
		"remark-gfm": "^4.0.1",
		"shiki": "4.4.2",
		"skullet": "0.0.3",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@graphical/editor": "file:./graphical/packages/editor-1.0.4.tgz",
		"@playwright/test": "1.62.0",
		"@rudel/typescript-config": "workspace:*",
		"@tailwindcss/vite": "^4.1.0",
		"@testing-library/jest-dom": "6.6.3",
		"@testing-library/react": "16.3.0",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "^22.0.0",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@vitejs/plugin-react": "^5.1.1",
		"agentation": "^2.3.3",
		"bun-types": "latest",
		"jsdom": "26.1.0",
		"shadcn": "^4.1.0",
		"tailwindcss": "^4.1.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "~5.9.3",
		"vite": "7.3.8",
		"vitest": "3.2.7"
	}
